---
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
import Silk from '../components/reactbits/Silk.jsx';
import TerminalModal from '../components/reactbits/TerminalModal.jsx';

interface Props {
    title?: string;
    description?: string;
    current?: 'home' | 'writing' | 'error' | 'cv';
    robots?: string;
    ogType?: 'website' | 'article';
    publishDate?: Date;
}

const {
    title = site.title,
    description = site.metaDescription,
    current = 'home',
    robots = 'index, follow',
    ogType = 'website',
    publishDate,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.origin);
const ogImage = new URL('/logo.png', canonical);
---

<!doctype html>
<html lang="en" data-theme="dim">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content={robots} />
        <meta name="google-site-verification" content="CzasoT22yliYRgGzRIHWJj8pcdk7x-42wabO8lYSfkc" />
        <link rel="canonical" href={canonical.href} />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical.href} />
        <meta property="og:image" content={ogImage.href} />
        {ogType === 'article' && publishDate && (
            <meta property="article:published_time" content={publishDate.toISOString()} />
            <meta property="article:author" content={site.name} />
        )}
        <meta property="og:image:width" content="512" />
        <meta property="og:image:height" content="512" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content="SBK.dev Logo" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage.href} />
        <link rel="icon" href="/favicon.ico" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/icon-48.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/icon-48.png" />
        <link rel="icon" type="image/png" sizes="180x180" href="/icon-192.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
        <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="alternate" type="application/rss+xml" title={`${site.mark} writing`} href="/rss.xml" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Agdasima:wght@400;700&family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            "name": site.name,
            "jobTitle": "Full-Stack Systems Developer & AWS Cloud Consultant",
            "url": canonical.href,
            "image": new URL('/logo.png', canonical).href,
            "logo": {
                "@type": "ImageObject",
                "url": new URL('/logo.png', canonical).href,
                "width": 512,
                "height": 512
            },
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Durban",
                "addressCountry": "South Africa"
            },
            "sameAs": [
                site.githubUrl,
                site.linkedinUrl
            ],
            "knowsAbout": [
                "Full-Stack Web Development",
                "AWS Cloud Architecture (VPC, EC2, CI/CD)",
                "Relational Database Systems",
                "Application Security",
                "System Modernization"
            ]
        })} />
        <script is:inline>
            (function() {
                // Kill all transitions BEFORE anything is painted to avoid flash
                var s = document.createElement('style');
                s.id = '__no-transition';
                s.textContent = '*, *::before, *::after { transition: none !important; }';
                document.head.appendChild(s);

                var saved = localStorage.getItem('theme:preference');
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

                if (saved === 'bright' || (!saved && !prefersDark)) {
                    document.documentElement.setAttribute('data-theme', 'bright');
                } else {
                    document.documentElement.setAttribute('data-theme', 'dim');
                }

                // Re-enable transitions after one paint cycle
                requestAnimationFrame(function() {
                    requestAnimationFrame(function() {
                        var el = document.getElementById('__no-transition');
                        if (el) el.parentNode.removeChild(el);
                    });
                });
            })();
        </script>
    </head>
    <body>
        <div class="bg-canvas-wrapper" style="position: fixed; inset: 0; z-index: -1; pointer-events: none;">
            <Silk
                client:only="react"
                speed={5}
                scale={1}
                color="#1a0a2e"
                noiseIntensity={1.5}
                rotation={0}
            />
        </div>
        <TerminalModal client:only="react" />
        <a class="skip-link" href="#main">Skip to content</a>
        <Nav current={current} />
        <main id="main">
            <slot />
        </main>
        <script>
            // Intersection Observer for scroll animations
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!reduced) {
                const io = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                io.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.08 }
                );
                document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
            } else {
                document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
            }

            // Simple Event Tracking for Custom Interactions (like CV downloads)
            document.querySelectorAll('[data-event]').forEach(el => {
                el.addEventListener('click', (e) => {
                    const eventName = (e.currentTarget as HTMLElement).getAttribute('data-event');
                    console.log(`[Analytics Track]: Event triggered - ${eventName}`);
                    // If Cloudflare Web Analytics is active, it automatically tracks pageviews.
                    // For custom events, you could push to a dataLayer or custom endpoint here.
                });
            });
        </script>
    </body>
</html>

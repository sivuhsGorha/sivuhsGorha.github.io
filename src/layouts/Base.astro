---
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
import Silk from '../components/reactbits/Silk.jsx';
import TerminalModal from '../components/reactbits/TerminalModal.jsx';

interface Props {
    title?: string;
    description?: string;
    current?: 'home' | 'writing';
}

const {
    title = site.title,
    description = site.metaDescription,
    current = 'home',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.origin);
const ogImage = new URL('/og.png', canonical);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical.href} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical.href} />
        <meta property="og:image" content={ogImage.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content="Sibongakonke Simamane — Junior Systems Developer Logo" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage.href} />
        <link rel="icon" type="image/svg+xml" href="/logo.svg" />
        <link rel="alternate" type="application/rss+xml" title={`${site.mark} writing`} href="/rss.xml" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Agdasima:wght@400;700&family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
    </head>
    <body>
        <div style="position: fixed; inset: 0; z-index: -1; pointer-events: none;">
            <Silk
                client:only="react"
                speed={5}
                scale={1}
                color="#1a0a2e"
                noiseIntensity={1.5}
                rotation={0}
            />
        </div>
        <TerminalModal client:only="react" />
        <a class="skip-link" href="#main">Skip to content</a>
        <Nav current={current} />
        <main id="main">
            <slot />
        </main>
        <script>
            // Intersection Observer for scroll animations
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!reduced) {
                const io = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                io.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.08 }
                );
                document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
            } else {
                document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
            }

            // Simple Event Tracking for Custom Interactions (like CV downloads)
            document.querySelectorAll('[data-event]').forEach(el => {
                el.addEventListener('click', (e) => {
                    const eventName = (e.currentTarget as HTMLElement).getAttribute('data-event');
                    console.log(`[Analytics Track]: Event triggered - ${eventName}`);
                    // If Cloudflare Web Analytics is active, it automatically tracks pageviews.
                    // For custom events, you could push to a dataLayer or custom endpoint here.
                });
            });
        </script>
    </body>
</html>

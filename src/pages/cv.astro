---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv.mjs';

const c = cv.contact;
---

<Base title={`Curriculum Vitae — ${cv.name}`} description={`Curriculum Vitae of ${cv.name} — ${cv.headline}.`} current="cv">
    <section class="cv-page reveal">
        <div class="wrap">
            <div class="cv-top-bar">
                <a class="article-back" href="/">← Back to portfolio</a>
                <a class="btn btn-primary cv-download-btn" href="/Sibongakonke_Simamane_CV.pdf" download="Sibongakonke_Simamane_CV.pdf">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Download CV (PDF)
                </a>
            </div>

            <div class="cv-sheet">
                <div class="cv-sheet-header">
                    <div>
                        <h1 class="cv-name">{cv.name}</h1>
                        <p class="cv-role">{cv.headline}</p>
                        <div class="cv-meta-links">
                            <span>{c.location}</span>
                            <span>•</span>
                            <span>{c.phone}</span>
                            <span>•</span>
                            <a href={`mailto:${c.email}`}>{c.email}</a>
                            <span>•</span>
                            <a href={c.website.url} target="_blank" rel="noopener noreferrer">{c.website.label}</a>
                            <span>•</span>
                            <a href={c.github.url} target="_blank" rel="noopener noreferrer">{c.github.label}</a>
                            <span>•</span>
                            <a href={c.linkedin.url} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                        </div>
                    </div>
                    <div class="cv-distinction-badge">
                        <div class="dist-title">DIPLOMA</div>
                        <div class="dist-score">76% Distinction</div>
                        <div class="dist-code">HDIPSD2 • Boston City Campus</div>
                    </div>
                </div>

                <div class="cv-block">
                    <h2 class="cv-sec-title">Summary</h2>
                    <p class="cv-summary" set:html={cv.summary} />
                </div>

                <div class="cv-block">
                    <h2 class="cv-sec-title">Skills</h2>
                    <div class="cv-skills-grid">
                        {cv.skills.map((s) => (
                            <div class="cv-skill-card">
                                <h3>{s.label}</h3>
                                <p class="cv-skill-items">{s.items}</p>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="cv-block">
                    <h2 class="cv-sec-title">Experience</h2>
                    {cv.experience.map((j) => (
                        <div class="cv-exp-item">
                            <div class="cv-exp-header">
                                <div>
                                    <h3 class="cv-job-title">{j.title}</h3>
                                    <div class="cv-company">{j.company}</div>
                                </div>
                                <span class="cv-date">{j.dates}</span>
                            </div>
                            <div class="cv-location">{j.location}</div>
                            <ul class="cv-bullets">
                                {j.bullets.map((b) => <li set:html={b} />)}
                            </ul>
                        </div>
                    ))}
                </div>

                <div class="cv-block">
                    <h2 class="cv-sec-title">{cv.projectsTitle}</h2>
                    {cv.projects.map((p) => (
                        <div class="cv-exp-item">
                            <div class="cv-exp-header">
                                <div>
                                    <h3 class="cv-job-title">{p.name}</h3>
                                    {p.link && (
                                        <div class="cv-company">
                                            <a href={p.link.url} target="_blank" rel="noopener noreferrer" style="color: var(--amber);">{p.link.label}</a>
                                        </div>
                                    )}
                                </div>
                                <span class="cv-date">{p.dates}</span>
                            </div>
                            <div class="cv-location">{p.stack}</div>
                            <ul class="cv-bullets">
                                {p.bullets.map((b) => <li set:html={b} />)}
                            </ul>
                        </div>
                    ))}
                </div>

                <div class="cv-block">
                    <h2 class="cv-sec-title">Education &amp; Certifications</h2>
                    {cv.education.map((e) => (
                        <div class="cv-edu-card">
                            <div class="cv-exp-header">
                                <div>
                                    <h3 class="cv-job-title">{e.title}</h3>
                                    <div class="cv-company">{e.school}</div>
                                </div>
                                <span class="cv-date">{e.dates}</span>
                            </div>
                            {e.note && <p class="cv-edu-line">{e.note}</p>}
                            {e.detail && <p class="cv-edu-line">{e.detail}</p>}
                        </div>
                    ))}
                    <p class="cv-edu-line"><strong>Certifications:</strong> {cv.certifications.map((x) => x.name + (x.note ? ` (${x.note})` : '')).join(', ')}</p>
                    <p class="cv-edu-line"><strong>Languages:</strong> {cv.languages}</p>
                </div>
            </div>
        </div>
    </section>
</Base>

<style>
    .cv-skill-items {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
    }

    .cv-edu-line {
        margin: 6px 0 0;
        font-size: 14px;
    }

    .cv-page {
        padding: 56px 0 96px;
    }

    .cv-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .cv-download-btn {
        display: flex;
        align-items: center;
        font-family: 'JetBrains Mono', monospace;
    }

    .cv-sheet {
        background: rgba(14, 10, 20, 0.75);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(227, 168, 87, 0.25);
        border-radius: 8px;
        padding: 42px 48px;
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
    }

    .cv-sheet-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid rgba(227, 168, 87, 0.2);
        padding-bottom: 24px;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .cv-name {
        font-family: 'Fraunces', serif;
        font-size: 38px;
        color: var(--paper, #ffffff);
        margin: 0 0 6px;
    }

    .cv-role {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: var(--amber);
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .cv-meta-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13.5px;
        color: var(--steel, #f4f6fc);
    }

    .cv-meta-links a {
        color: var(--paper, #ffffff);
        text-decoration: none;
    }

    .cv-meta-links a:hover {
        color: var(--amber);
    }

    .cv-distinction-badge {
        background: rgba(227, 168, 87, 0.08);
        border: 1px solid rgba(227, 168, 87, 0.5);
        border-radius: 6px;
        padding: 10px 16px;
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
    }

    .dist-title {
        font-size: 11px;
        color: var(--steel, #f4f6fc);
        letter-spacing: 0.05em;
    }

    .dist-score {
        font-size: 15px;
        font-weight: 600;
        color: var(--amber);
        margin: 2px 0;
    }

    .dist-code {
        font-size: 11px;
        color: var(--paper, #ffffff);
    }

    .cv-block {
        margin-bottom: 32px;
    }

    .cv-sec-title {
        font-family: 'Fraunces', serif;
        font-size: 19px;
        color: var(--amber);
        letter-spacing: 0.02em;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid rgba(227, 168, 87, 0.15);
        padding-bottom: 6px;
    }

    .cv-sec-title span {
        color: var(--paper, #ffffff);
    }

    .cv-summary {
        color: var(--steel, #f4f6fc);
        font-size: 16px;
        line-height: 1.6;
        margin: 0;
    }

    .cv-summary strong {
        color: var(--paper, #ffffff);
    }

    .cv-skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 14px;
    }

    .cv-skill-card {
        background: rgba(14, 10, 20, 0.6);
        border: 1px solid rgba(227, 168, 87, 0.16);
        border-left: 3px solid var(--amber);
        border-radius: 4px;
        padding: 12px 14px;
    }

    .cv-skill-card h3 {
        font-family: 'Fraunces', serif;
        font-size: 14.5px;
        color: var(--paper, #ffffff);
        margin-bottom: 8px;
    }

    .cv-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .cv-chips span {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11.5px;
        padding: 2px 8px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--steel, #f4f6fc);
    }

    .cv-chips span.chip-accent {
        background: rgba(227, 168, 87, 0.15);
        border-color: rgba(227, 168, 87, 0.4);
        color: var(--amber);
        font-weight: 500;
    }

    .cv-exp-item {
        margin-bottom: 22px;
    }

    .cv-exp-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 8px;
    }

    .cv-job-title {
        font-family: 'Fraunces', serif;
        font-size: 20px;
        font-weight: 500;
        color: var(--paper, #ffffff);
        margin: 0;
    }

    .cv-company {
        color: var(--amber);
        font-weight: 500;
        font-size: 15px;
    }

    .cv-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        color: var(--steel, #f4f6fc);
    }

    .cv-location {
        font-size: 13px;
        color: var(--steel, #f4f6fc);
        font-style: italic;
        margin: 2px 0 8px;
    }

    .cv-bullets {
        list-style: none;
        padding-left: 0;
        margin: 0;
    }

    .cv-bullets li {
        position: relative;
        padding-left: 22px;
        margin-bottom: 7px;
        color: var(--steel, #f4f6fc);
        font-size: 15px;
        line-height: 1.55;
    }

    .cv-bullets li::before {
        content: '▪';
        position: absolute;
        left: 0;
        color: var(--amber);
    }

    .cv-bullets strong {
        color: var(--paper, #ffffff);
    }

    .cv-edu-card {
        background: rgba(14, 10, 20, 0.6);
        border: 1px solid rgba(227, 168, 87, 0.2);
        border-left: 3px solid var(--amber);
        border-radius: 6px;
        padding: 16px 20px;
    }

    .cv-scores-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 8px 16px;
        padding-top: 10px;
        border-top: 1px solid rgba(227, 168, 87, 0.15);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12.5px;
        color: var(--steel, #f4f6fc);
    }

    .cv-scores-grid strong {
        color: var(--amber);
    }

    .cv-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
    }

    @media (max-width: 760px) {
        .cv-sheet {
            padding: 24px 20px;
        }
        .cv-two-col {
            grid-template-columns: 1fr;
        }
    }

    @media print {
        :global(body) {
            background: #ffffff !important;
            color: #111827 !important;
        }

        :global(nav),
        :global(footer),
        .cv-top-bar {
            display: none !important;
        }

        .cv-page {
            padding: 0 !important;
        }

        .wrap {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .cv-sheet {
            background: #ffffff !important;
            border: none !important;
            padding: 0 !important;
            box-shadow: none !important;
            backdrop-filter: none !important;
        }

        .cv-name {
            color: #0f172a !important;
        }

        .cv-role {
            color: #b45309 !important;
        }

        .cv-meta-links,
        .cv-meta-links a,
        .cv-meta-links span {
            color: #475569 !important;
        }

        .cv-distinction-badge {
            background: #fffbeb !important;
            border: 1px solid #d97706 !important;
        }

        .dist-title, .dist-code {
            color: #64748b !important;
        }

        .dist-score {
            color: #b45309 !important;
        }

        .cv-sec-title {
            color: #b45309 !important;
            border-bottom: 1.5px solid #d97706 !important;
            page-break-after: avoid;
            break-after: avoid;
        }

        .cv-sec-title span {
            color: #0f172a !important;
        }

        .cv-summary {
            color: #334155 !important;
        }

        .cv-summary strong {
            color: #0f172a !important;
        }

        .cv-skill-card {
            background: #f8fafc !important;
            border: 1px solid #cbd5e1 !important;
            border-left: 3px solid #d97706 !important;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .cv-skill-card h3 {
            color: #0f172a !important;
        }

        .cv-chips span {
            background: #e2e8f0 !important;
            border-color: #cbd5e1 !important;
            color: #334155 !important;
        }

        .cv-chips span.chip-accent {
            background: #fef3c7 !important;
            border-color: #fde68a !important;
            color: #92400e !important;
            font-weight: 600;
        }

        .cv-job-title {
            color: #0f172a !important;
        }

        .cv-company {
            color: #b45309 !important;
        }

        .cv-date,
        .cv-location {
            color: #64748b !important;
        }

        .cv-bullets li {
            color: #334155 !important;
        }

        .cv-bullets li::before {
            color: #d97706 !important;
        }

        .cv-bullets strong {
            color: #0f172a !important;
        }

        .cv-edu-card {
            background: #f8fafc !important;
            border: 1px solid #cbd5e1 !important;
            border-left: 3px solid #d97706 !important;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .cv-scores-grid {
            border-top: 1px solid #e2e8f0 !important;
            color: #475569 !important;
        }

        .cv-scores-grid strong {
            color: #b45309 !important;
        }

        .cv-exp-item {
            page-break-inside: avoid;
            break-inside: avoid;
        }
    }
</style>



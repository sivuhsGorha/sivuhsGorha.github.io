---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`Curriculum Vitae — ${site.name}`} description={`Curriculum Vitae of ${site.name} — Junior Systems Developer.`}>
    <section class="cv-page reveal">
        <div class="wrap">
            <div class="cv-top-bar">
                <a class="article-back" href="/">← Back to portfolio</a>
                <a class="btn btn-primary cv-download-btn" href="/Sibongakonke_Simamane_CV.pdf" download="Sibongakonke_Simamane_CV.pdf">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Download CV (PDF)
                </a>
            </div>

            <!-- CV Document Container -->
            <div class="cv-sheet">
                <!-- Header -->
                <div class="cv-sheet-header">
                    <div>
                        <h1 class="cv-name">{site.name}</h1>
                        <p class="cv-role">{site.role}</p>
                        <div class="cv-meta-links">
                            <span>📍 {site.city}</span>
                            <span>•</span>
                            <a href={`mailto:${site.email}`}>✉️ {site.email}</a>
                            <span>•</span>
                            <span>📞 {site.phone}</span>
                            <span>•</span>
                            <a href={site.origin} target="_blank">🌐 sibongakonke-simamane.dev</a>
                            <span>•</span>
                            <a href={site.githubUrl} target="_blank">💻 {site.githubLabel}</a>
                            <span>•</span>
                            <a href={site.linkedinUrl} target="_blank">🔗 LinkedIn</a>
                        </div>
                    </div>
                    <div class="cv-distinction-badge">
                        <div class="dist-title">BOSTON DIPLOMA</div>
                        <div class="dist-score">76% Distinction Pass</div>
                        <div class="dist-code">HDIPSD2 • Confirmed 2026</div>
                    </div>
                </div>

                <!-- Profile -->
                <div class="cv-block">
                    <h2 class="cv-sec-title"><span>//</span> Professional Profile</h2>
                    <p class="cv-summary">
                        Driven and technically versatile <strong>Systems Development graduate</strong> currently employed as a Junior Systems Developer at <strong>Future ProTechY (PTY) LTD</strong>. Holds a confirmed Diploma (HDIPSD2) from Boston City Campus with a <strong>76% Pass with Distinction</strong> average, alongside <strong>CompTIA A+</strong> and <strong>CompTIA Security+</strong> foundations. Experienced across full-stack engineering — <strong>Java, PHP, JavaScript, React, Node.js, Docker, and MySQL</strong> — with practical rigor in cybersecurity, database design, software testing, and business analysis. Currently gaining hands-on exposure to <strong>AWS cloud infrastructure</strong> in a professional environment and actively seeking to grow in this area with the support of experienced mentors.
                    </p>
                </div>

                <!-- Technical Skills -->
                <div class="cv-block">
                    <h2 class="cv-sec-title"><span>//</span> Technical Competencies</h2>
                    <div class="cv-skills-grid">
                        <div class="cv-skill-card">
                            <h3>Core Languages & Architecture</h3>
                            <div class="cv-chips">
                                <span class="chip-accent">Java</span>
                                <span class="chip-accent">PHP</span>
                                <span class="chip-accent">JavaScript (ES6+)</span>
                                <span>C</span>
                                <span>HTML5</span>
                                <span>CSS3 / Tailwind</span>
                            </div>
                        </div>
                        <div class="cv-skill-card">
                            <h3>Frontend & Frameworks</h3>
                            <div class="cv-chips">
                                <span class="chip-accent">React.js</span>
                                <span>Vue.js</span>
                                <span class="chip-accent">Astro</span>
                                <span>Responsive UI</span>
                                <span>SPA Architecture</span>
                            </div>
                        </div>
                        <div class="cv-skill-card">
                            <h3>Backend, Cloud & DevOps</h3>
                            <div class="cv-chips">
                                <span class="chip-accent">Node.js</span>
                                <span>Express</span>
                                <span class="chip-accent">Docker</span>
                                <span>Kubernetes</span>
                                <span>AWS (Learning � VPC, EC2, CI/CD)</span>
                                <span>Nginx</span>
                            </div>
                        </div>
                        <div class="cv-skill-card">
                            <h3>Databases & Data Modeling</h3>
                            <div class="cv-chips">
                                <span class="chip-accent">MySQL</span>
                                <span>MS SQL Server</span>
                                <span>Relational Schema</span>
                                <span>Query Optimization</span>
                            </div>
                        </div>
                        <div class="cv-skill-card">
                            <h3>Cybersecurity & Networking</h3>
                            <div class="cv-chips">
                                <span class="chip-accent">CompTIA A+ (2024)</span>
                                <span class="chip-accent">CompTIA Security+</span>
                                <span>Ethical Hacking</span>
                                <span>LAN & Cabling</span>
                            </div>
                        </div>
                        <div class="cv-skill-card">
                            <h3>Methodologies & Emerging Tech</h3>
                            <div class="cv-chips">
                                <span>Agile / Scrum</span>
                                <span>Software Testing</span>
                                <span>BPM & Analysis</span>
                                <span class="chip-accent">Prompt Engineering / AI</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Experience -->
                <div class="cv-block">
                    <h2 class="cv-sec-title"><span>//</span> Work Experience</h2>
                    <div class="cv-exp-item">
                        <div class="cv-exp-header">
                            <div>
                                <h3 class="cv-job-title">Junior Systems Developer & Cloud Engineer</h3>
                                <div class="cv-company">Future ProTechY (PTY) LTD</div>
                            </div>
                            <span class="cv-date">May 2026 – Present</span>
                        </div>
                        <div class="cv-location">Durban, KwaZulu-Natal • Full-time</div>
                        <ul class="cv-bullets">
                            <li>Gaining hands-on exposure to <strong>Amazon Web Services (AWS)</strong> cloud infrastructure in a professional environment — working with <strong>VPCs</strong>, subnets, security groups, and <strong>EC2 compute instances</strong>. Actively building cloud skills and open to mentorship and further professional development in this area.</li>
                            <li>Designing, automating, and maintaining <strong>CI/CD pipelines</strong> and automated zero-downtime deployments for production software.</li>
                            <li>Developing robust full-stack applications and backend services using <strong>Java, PHP, JavaScript, and MySQL</strong> supporting high-volume financial services systems.</li>
                            <li>Managing application performance, server monitoring, reverse proxies, and infrastructure security under strict operational standards.</li>
                        </ul>
                    </div>

                    <div class="cv-exp-item">
                        <div class="cv-exp-header">
                            <div>
                                <h3 class="cv-job-title">Fiber Installation Technician & Administrator</h3>
                                <div class="cv-company">Babicon (PTY) LTD</div>
                            </div>
                            <span class="cv-date">Mar 2026 – May 2026</span>
                        </div>
                        <div class="cv-location">Durban, KwaZulu-Natal • Contract / Field & Technical Operations</div>
                        <ul class="cv-bullets">
                            <li>Performed fiber optic network installations, termination, and routing configurations at client sites across the Durban metropolitan region.</li>
                            <li>Handled administrative functions including project documentation, client handovers, reporting, and operational coordination.</li>
                            <li>Worked across both technical field deployment roles and office-based administrative responsibilities.</li>
                            <li>Gained hands-on mastery in physical network infrastructure, structured cabling, optical testing, and ISP deployment processes.</li>
                        </ul>
                    </div>

                    <div class="cv-exp-item">
                        <div class="cv-exp-header">
                            <div>
                                <h3 class="cv-job-title">Part-Time Systems Technician</h3>
                                <div class="cv-company">Inguni Shield</div>
                            </div>
                            <span class="cv-date">Feb 2025 – Jan 2026</span>
                        </div>
                        <div class="cv-location">Durban, KwaZulu-Natal • Part-time</div>
                        <ul class="cv-bullets">
                            <li>Performed system configurations, programming, and hardware/software installations across client environments.</li>
                            <li>Worked across multiple programming languages including <strong>C and Java</strong> in a live technical support and systems implementation context.</li>
                            <li>Gained exposure to static website development and responsive architectures using modern JavaScript-based tooling and frameworks (Astro).</li>
                            <li>Supported commercial clients with proactive technical troubleshooting, diagnostic analysis, and continuous maintenance.</li>
                        </ul>
                    </div>

                    <div class="cv-exp-item">
                        <div class="cv-exp-header">
                            <div>
                                <h3 class="cv-job-title">EA Group Leader — BEEI Phase V</h3>
                                <div class="cv-company">Zubane Primary School</div>
                            </div>
                            <span class="cv-date">June 2025 – Nov 2025</span>
                        </div>
                        <div class="cv-location">Ndwedwe, KwaZulu-Natal • Leadership & Programme Management</div>
                        <ul class="cv-bullets">
                            <li>Led a team of Education Assistants across daily attendance, task delivery, curriculum support, and compliance reporting.</li>
                            <li>Acted as primary liaison between government programme coordinators, school executive management, and team members.</li>
                            <li>Spearheaded onboarding, technical guidance, workflow optimization, and performance monitoring of newly appointed assistants.</li>
                        </ul>
                    </div>

                    <div class="cv-exp-item">
                        <div class="cv-exp-header">
                            <div>
                                <h3 class="cv-job-title">Education Assistant</h3>
                                <div class="cv-company">KZN Department of Basic Education</div>
                            </div>
                            <span class="cv-date">June 2025 – Nov 2025</span>
                        </div>
                        <div class="cv-location">Ndwedwe, KwaZulu-Natal • Government Programme</div>
                        <ul class="cv-bullets">
                            <li>Managed data capturing, electronic records management, and statutory reporting with zero discrepancy rate.</li>
                            <li>Handled confidential administrative information with full compliance and strict adherence to data protection standards.</li>
                            <li>Coordinated daily communication workflows between educational staff, administrative leadership, and external stakeholders.</li>
                            <li>Provided comprehensive technical and administrative support to guarantee smooth daily operational delivery.</li>
                        </ul>
                    </div>
                </div>

                <!-- Featured Projects -->
                <div class="cv-block">
                    <h2 class="cv-sec-title"><span>//</span> Featured Production Projects</h2>
                    <div class="cv-exp-item">
                        <div class="cv-exp-header">
                            <div>
                                <h3 class="cv-job-title">Full Business Platform & Web Application</h3>
                                <div class="cv-company">Asante Financial Services (<a href="https://asantefs.co.za" target="_blank" style="color: var(--amber);">asantefs.co.za</a>)</div>
                            </div>
                            <span class="cv-date">2026</span>
                        </div>
                        <div class="cv-location">Production Financial Platform • Stack: PHP, MySQL, JavaScript, HTML5, CSS3, Apache</div>
                        <ul class="cv-bullets">
                            <li>Architected and delivered the full online customer portal and business website for Asante Financial Services, a regulated personal finance provider.</li>
                            <li>Engineered a dynamic, database-driven loan application engine featuring multi-step form validation, document submission, and automated backend record processing.</li>
                            <li>Implemented secure data handling, input sanitization, and security-conscious storage routines complying with South African financial sector standards.</li>
                            <li>Managed the entire project lifecycle independently from requirements discovery and database schema modeling to production deployment.</li>
                        </ul>
                    </div>

                    <div class="cv-exp-item">
                        <div class="cv-exp-header">
                            <div>
                                <h3 class="cv-job-title">Production AWS Cloud Infrastructure & Automated CI/CD Pipeline</h3>
                                <div class="cv-company">Future ProTechY / Enterprise Deployment</div>
                            </div>
                            <span class="cv-date">2026</span>
                        </div>
                        <div class="cv-location">Cloud Architecture & DevOps • Stack: AWS (VPC, EC2, ALB, Route 53), Docker, GitHub Actions, Linux, Nginx</div>
                        <ul class="cv-bullets">
                            <li>Architected and implemented production cloud infrastructure on AWS engineered for high availability, network isolation, and automated delivery.</li>
                            <li>Designed isolated VPC topologies with segregated public and private subnets, internet gateways, NAT gateways, and custom security groups.</li>
                            <li>Provisioned EC2 compute instances behind an Application Load Balancer (ALB) with SSL/TLS termination and automated health checks.</li>
                            <li>Configured automated GitHub Actions CI/CD pipelines enabling streamlined, zero-downtime containerized deployments.</li>
                        </ul>
                    </div>

                    <div class="cv-exp-item">
                        <div class="cv-exp-header">
                            <div>
                                <h3 class="cv-job-title">Secure Financial Transaction & Processing Backend</h3>
                                <div class="cv-company">FinTech Systems Architecture</div>
                            </div>
                            <span class="cv-date">2026</span>
                        </div>
                        <div class="cv-location">Backend Architecture • Stack: Java, PHP, MySQL, RESTful APIs, CompTIA Security+ Standards</div>
                        <ul class="cv-bullets">
                            <li>Engineered a transactional backend engine processing high-integrity customer records, loan submissions, and verification workflows.</li>
                            <li>Structured a 3NF normalized relational schema in MySQL with strict referential constraints and sub-second query indexing.</li>
                            <li>Implemented idempotent RESTful API endpoints and defense-in-depth sanitization adhering to CompTIA Security+ guidelines.</li>
                        </ul>
                    </div>
                </div>

                <!-- Education -->
                <div class="cv-block">
                    <h2 class="cv-sec-title"><span>//</span> Education & Academic Credentials</h2>
                    <div class="cv-edu-card">
                        <div class="cv-exp-header">
                            <div>
                                <h3 class="cv-job-title">Diploma in Systems Development (HDIPSD2)</h3>
                                <div class="cv-company">Boston City Campus</div>
                            </div>
                            <span class="cv-date">2023 – 2026</span>
                        </div>
                        <div style="color: var(--amber); font-weight: 500; font-size: 14px; margin: 4px 0 8px;">
                            Graduated with Distinction • 76% Overall Average • Diploma Confirmed by Office of the Registrar (April 2026)
                        </div>
                        <div class="cv-scores-grid">
                            <div>Systems Analysis & Design: <strong>90%</strong></div>
                            <div>Praxis / Applied Systems: <strong>92%</strong></div>
                            <div>Security+ Fundamentals: <strong>88%</strong></div>
                            <div>Software Testing: <strong>86%</strong></div>
                            <div>Java & Database Systems: <strong>86%</strong></div>
                            <div>Computer Literacy: <strong>Distinction</strong></div>
                        </div>
                    </div>
                </div>

                <!-- Languages & Interests -->
                <div class="cv-two-col">
                    <div class="cv-block">
                        <h2 class="cv-sec-title"><span>//</span> Languages</h2>
                        <ul class="cv-bullets">
                            <li><strong>isiZulu:</strong> Home Language (Native / Fluent)</li>
                            <li><strong>English:</strong> Professional Working Proficiency (Fluent)</li>
                        </ul>
                    </div>
                    <div class="cv-block">
                        <h2 class="cv-sec-title"><span>//</span> Focus & Interests</h2>
                        <ul class="cv-bullets">
                            <li>Full-Stack & Cloud Architecture (AWS / Docker)</li>
                            <li>Cybersecurity Research & Penetration Testing</li>
                            <li>AI Workflow Engineering & Developer Tooling</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Base>

<style>
    .cv-page {
        padding: 56px 0 96px;
    }

    .cv-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .cv-download-btn {
        display: flex;
        align-items: center;
        font-family: 'JetBrains Mono', monospace;
    }

    .cv-sheet {
        background: rgba(14, 10, 20, 0.75);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(227, 168, 87, 0.25);
        border-radius: 8px;
        padding: 42px 48px;
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
    }

    .cv-sheet-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid rgba(227, 168, 87, 0.2);
        padding-bottom: 24px;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .cv-name {
        font-family: 'Fraunces', serif;
        font-size: 38px;
        color: var(--paper, #ffffff);
        margin: 0 0 6px;
    }

    .cv-role {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: var(--amber);
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .cv-meta-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13.5px;
        color: var(--steel, #f4f6fc);
    }

    .cv-meta-links a {
        color: var(--paper, #ffffff);
        text-decoration: none;
    }

    .cv-meta-links a:hover {
        color: var(--amber);
    }

    .cv-distinction-badge {
        background: rgba(227, 168, 87, 0.08);
        border: 1px solid rgba(227, 168, 87, 0.5);
        border-radius: 6px;
        padding: 10px 16px;
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
    }

    .dist-title {
        font-size: 11px;
        color: var(--steel, #f4f6fc);
        letter-spacing: 0.05em;
    }

    .dist-score {
        font-size: 15px;
        font-weight: 600;
        color: var(--amber);
        margin: 2px 0;
    }

    .dist-code {
        font-size: 11px;
        color: var(--paper, #ffffff);
    }

    .cv-block {
        margin-bottom: 32px;
    }

    .cv-sec-title {
        font-family: 'Fraunces', serif;
        font-size: 19px;
        color: var(--amber);
        letter-spacing: 0.02em;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid rgba(227, 168, 87, 0.15);
        padding-bottom: 6px;
    }

    .cv-sec-title span {
        color: var(--paper, #ffffff);
    }

    .cv-summary {
        color: var(--steel, #f4f6fc);
        font-size: 16px;
        line-height: 1.6;
        margin: 0;
    }

    .cv-summary strong {
        color: var(--paper, #ffffff);
    }

    .cv-skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 14px;
    }

    .cv-skill-card {
        background: rgba(14, 10, 20, 0.6);
        border: 1px solid rgba(227, 168, 87, 0.16);
        border-left: 3px solid var(--amber);
        border-radius: 4px;
        padding: 12px 14px;
    }

    .cv-skill-card h3 {
        font-family: 'Fraunces', serif;
        font-size: 14.5px;
        color: var(--paper, #ffffff);
        margin-bottom: 8px;
    }

    .cv-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .cv-chips span {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11.5px;
        padding: 2px 8px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--steel, #f4f6fc);
    }

    .cv-chips span.chip-accent {
        background: rgba(227, 168, 87, 0.15);
        border-color: rgba(227, 168, 87, 0.4);
        color: var(--amber);
        font-weight: 500;
    }

    .cv-exp-item {
        margin-bottom: 22px;
    }

    .cv-exp-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 8px;
    }

    .cv-job-title {
        font-family: 'Fraunces', serif;
        font-size: 20px;
        font-weight: 500;
        color: var(--paper, #ffffff);
        margin: 0;
    }

    .cv-company {
        color: var(--amber);
        font-weight: 500;
        font-size: 15px;
    }

    .cv-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        color: var(--steel, #f4f6fc);
    }

    .cv-location {
        font-size: 13px;
        color: var(--steel, #f4f6fc);
        font-style: italic;
        margin: 2px 0 8px;
    }

    .cv-bullets {
        list-style: none;
        padding-left: 0;
        margin: 0;
    }

    .cv-bullets li {
        position: relative;
        padding-left: 22px;
        margin-bottom: 7px;
        color: var(--steel, #f4f6fc);
        font-size: 15px;
        line-height: 1.55;
    }

    .cv-bullets li::before {
        content: '▪';
        position: absolute;
        left: 0;
        color: var(--amber);
    }

    .cv-bullets strong {
        color: var(--paper, #ffffff);
    }

    .cv-edu-card {
        background: rgba(14, 10, 20, 0.6);
        border: 1px solid rgba(227, 168, 87, 0.2);
        border-left: 3px solid var(--amber);
        border-radius: 6px;
        padding: 16px 20px;
    }

    .cv-scores-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 8px 16px;
        padding-top: 10px;
        border-top: 1px solid rgba(227, 168, 87, 0.15);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12.5px;
        color: var(--steel, #f4f6fc);
    }

    .cv-scores-grid strong {
        color: var(--amber);
    }

    .cv-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
    }

    @media (max-width: 760px) {
        .cv-sheet {
            padding: 24px 20px;
        }
        .cv-two-col {
            grid-template-columns: 1fr;
        }
    }

    @media print {
        :global(body) {
            background: #ffffff !important;
            color: #111827 !important;
        }

        :global(nav),
        :global(footer),
        .cv-top-bar {
            display: none !important;
        }

        .cv-page {
            padding: 0 !important;
        }

        .wrap {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .cv-sheet {
            background: #ffffff !important;
            border: none !important;
            padding: 0 !important;
            box-shadow: none !important;
            backdrop-filter: none !important;
        }

        .cv-name {
            color: #0f172a !important;
        }

        .cv-role {
            color: #b45309 !important;
        }

        .cv-meta-links,
        .cv-meta-links a,
        .cv-meta-links span {
            color: #475569 !important;
        }

        .cv-distinction-badge {
            background: #fffbeb !important;
            border: 1px solid #d97706 !important;
        }

        .dist-title, .dist-code {
            color: #64748b !important;
        }

        .dist-score {
            color: #b45309 !important;
        }

        .cv-sec-title {
            color: #b45309 !important;
            border-bottom: 1.5px solid #d97706 !important;
            page-break-after: avoid;
            break-after: avoid;
        }

        .cv-sec-title span {
            color: #0f172a !important;
        }

        .cv-summary {
            color: #334155 !important;
        }

        .cv-summary strong {
            color: #0f172a !important;
        }

        .cv-skill-card {
            background: #f8fafc !important;
            border: 1px solid #cbd5e1 !important;
            border-left: 3px solid #d97706 !important;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .cv-skill-card h3 {
            color: #0f172a !important;
        }

        .cv-chips span {
            background: #e2e8f0 !important;

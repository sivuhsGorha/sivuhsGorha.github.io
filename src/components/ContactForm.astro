---
// ContactForm.astro using Formspree
import ColorBends from './reactbits/ColorBends.jsx';
import { site } from '../data/site';
const FORMSPREE_URL = "https://formspree.io/f/xeaqrzqk";
---

<section id="contact" class="contact-section reveal">
    <div class="wrap" style="width: 100%; display: flex; flex-direction: column; align-items: center;">
        <div class="section-header">
            <p class="eyebrow-num" style="margin-bottom: 8px;">09 / project inquiry</p>
            <h2><span class="highlight">Start</span> A Project</h2>
            <p>Have a project in mind, need AWS cloud infrastructure, or looking for contract engineering? Let's discuss your requirements and timeline.</p>
        </div>

        <div class="form-container" style="position: relative; overflow: hidden;">
            <!-- ColorBends Background -->
            <div style="position: absolute; inset: 0; z-index: 0; pointer-events: auto;">
                <ColorBends 
                    client:only="react"
                    colors={["#e3a857", "#896ABD", "#1a0a2e"]}
                    rotation={90}
                    speed={0.2}
                    scale={1}
                    frequency={1}
                    warpStrength={1}
                    mouseInfluence={1}
                    noise={0.15}
                    parallax={0.5}
                    iterations={1}
                    intensity={0.9}
                    bandWidth={6}
                    transparent={true}
                />
            </div>

            <form action={FORMSPREE_URL} method="POST" id="contact-form" style="position: relative; z-index: 1; width: 100%;">
                
                <div class="input-grid">
                    <div class="input-group">
                        <label for="name">Your Name</label>
                        <input type="text" name="name" id="name" required placeholder="Alex Morgan" />
                    </div>

                    <div class="input-group">
                        <label for="email">Work Email</label>
                        <input type="email" name="email" id="email" required placeholder="alex@company.com" />
                    </div>
                </div>

                <div class="input-grid">
                    <div class="input-group">
                        <label for="service">Service / Inquiry Type</label>
                        <select name="service" id="service" required>
                            <option value="" disabled selected>Select a service...</option>
                            <option value="AWS Cloud Architecture & CI/CD Pipelines">AWS Cloud Architecture & CI/CD Pipelines</option>
                            <option value="Full-Stack Web Application / Portal">Full-Stack Web Application / Portal</option>
                            <option value="Custom Backend & Database System">Custom Backend & Database System</option>
                            <option value="Code Audit, Security & Performance">Code Audit, Security & Performance</option>
                            <option value="Contract Engineering / Other">Contract Engineering / Other</option>
                        </select>
                    </div>

                    <div class="input-group">
                        <label for="timeline">Estimated Timeline</label>
                        <select name="timeline" id="timeline">
                            <option value="ASAP (< 1 month)">ASAP (Under 1 month)</option>
                            <option value="1 - 3 months" selected>1 - 3 months</option>
                            <option value="Flexible / Exploratory">Flexible / Exploratory</option>
                            <option value="Ongoing Contract Retainer">Ongoing Contract Retainer</option>
                        </select>
                    </div>
                </div>

                <div class="input-group">
                    <label for="message">Project Scope & Details</label>
                    <textarea name="message" id="message" rows="5" required placeholder="Tell me about your project, existing systems, or what you are looking to build..."></textarea>
                </div>

                <button type="submit" class="submit-btn">Send Project Inquiry →</button>
                <div class="form-assurances">
                    <span>Response within 24 hours</span>
                    <span>•</span>
                    <span>Confidential & Direct</span>
                    <span>•</span>
                    <span>Free Discovery Call</span>
                </div>
                <p id="form-result" class="form-result" aria-live="polite"></p>

                <div class="whatsapp-direct-box">
                    <span>Prefer immediate messaging?</span>
                    <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="whatsapp-link-btn" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                        </svg>
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

<style>
    .contact-section {
        margin: 6rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .section-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .section-header p {
        color: var(--steel, #a9bcdc);
        max-width: 55ch;
        margin: 0 auto;
        font-size: 17px;
    }

    .form-container {
        width: 100%;
        max-width: 680px;
        background: rgba(26, 10, 46, 0.45);
        border: 1px solid rgba(227, 168, 87, 0.22);
        border-radius: 16px;
        padding: 2.5rem;
        backdrop-filter: blur(14px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    }

    .input-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .input-group {
        margin-bottom: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    label {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: var(--color-text-muted, #a9bcdc);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    input, select, textarea {
        width: 100%;
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        padding: 0.9rem 1rem;
        color: var(--color-text, #ffffff);
        font-family: var(--font-sans);
        font-size: 0.95rem;
        transition: border-color 0.25s ease, background 0.25s ease;
    }

    select {
        cursor: pointer;
    }

    select option {
        background: #0f172a;
        color: #ffffff;
    }

    input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--color-primary, #e3a857);
        background: rgba(15, 23, 42, 0.95);
        box-shadow: 0 0 12px rgba(227, 168, 87, 0.25);
    }

    .submit-btn {
        width: 100%;
        background: var(--color-primary, #e3a857);
        color: var(--color-bg, #0f1b2d);
        border: none;
        border-radius: 8px;
        padding: 1rem;
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        margin-top: 0.75rem;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        background: #eab86c;
        box-shadow: 0 6px 16px rgba(227, 168, 87, 0.35);
    }

    .form-assurances {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-top: 1.25rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: var(--steel, #a9bcdc);
        flex-wrap: wrap;
    }

    .form-result {
        margin-top: 1rem;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 0.9rem;
    }

    .whatsapp-direct-box {
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        text-align: center;
    }

    .whatsapp-direct-box span {
        font-size: 13px;
        color: var(--steel, #a9bcdc);
        font-family: var(--font-mono);
    }

    .whatsapp-link-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border-radius: 6px;
        text-decoration: none;
        background: rgba(227, 168, 87, 0.08);
        border: 1px solid rgba(227, 168, 87, 0.4);
        color: var(--amber, #e3a857);
        transition: all 0.2s ease;
    }

    .whatsapp-link-btn:hover,
    .whatsapp-link-btn:focus-visible {
        background: rgba(37, 211, 102, 0.16);
        border-color: #25d366;
        color: #25d366;
        box-shadow: 0 0 16px rgba(37, 211, 102, 0.4);
        transform: translateY(-1px);
    }

    @media (max-width: 600px) {
        .input-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }
        .form-container {
            padding: 1.75rem 1.25rem;
        }
    }
</style>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const result = document.getElementById('form-result');

    if (form && result) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(form);
            const object = Object.fromEntries(formData);
            const json = JSON.stringify(object);

            result.innerHTML = "Sending...";
            result.style.display = "block";
            result.style.color = "var(--color-text-muted)";

            fetch(form.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: json
            })
            .then(async (response) => {
                let json = await response.json();
                if (response.status === 200 || response.ok) {
                    result.innerHTML = "Message sent successfully!";
                    result.style.color = "#10b981"; // success green
                    form.reset();
                } else {
                    console.log(response);
                    // Formspree returns errors in an array sometimes
                    if (Object.hasOwn(json, 'errors')) {
                        result.innerHTML = json["errors"].map((error: { message: string }) => error["message"]).join(", ");
                    } else {
                        result.innerHTML = "Oops! There was a problem submitting your form";
                    }
                    result.style.color = "#ef4444"; // error red
                }
            })
            .catch(error => {
                console.log(error);
                result.innerHTML = "Something went wrong!";
                result.style.color = "#ef4444";
            })
            .finally(() => {
                setTimeout(() => {
                    result.style.display = "none";
                }, 5000);
            });
        });
    }
</script>


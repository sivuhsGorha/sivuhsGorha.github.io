---
// ContactForm.astro: guided, multi-step enquiry form using Formspree
import ColorBends from './reactbits/ColorBends.jsx';
import { site } from '../data/site';
const FORMSPREE_URL = "https://formspree.io/f/xeaqrzqk";

type Question = {
    label: string;
    kind: 'textarea' | 'text' | 'select';
    required?: boolean;
    options?: string[];
    hint?: string;
};

const services: { id: string; name: string; questions: Question[] }[] = [
    {
        id: 'web',
        name: 'Full-Stack Web Application / Portal',
        questions: [
            { label: 'What business problem should this application solve, and for whom?', kind: 'textarea', required: true, hint: 'A sentence or two is sufficient.' },
            { label: 'How is this handled at present (for example spreadsheets, email, paper, or an existing system)?', kind: 'textarea' },
            { label: 'Will the system handle personal or financial information?', kind: 'select', options: ['Yes', 'No', 'Not yet determined'], hint: 'This determines the security and compliance work involved.' },
            { label: 'Is there an existing website, system or database with which it must integrate?', kind: 'textarea' },
        ],
    },
    {
        id: 'aws',
        name: 'AWS Cloud Architecture & CI/CD Pipelines',
        questions: [
            { label: 'What is currently running, and where is it hosted?', kind: 'textarea', required: true, hint: 'For example: a single server with a hosting provider, or an existing AWS environment.' },
            { label: 'What is the primary concern?', kind: 'select', options: ['Deployment speed', 'Downtime and reliability', 'Cost', 'Security', 'Starting from scratch', 'Other'] },
            { label: 'Do you have an existing AWS account?', kind: 'select', options: ['Yes', 'No', 'Not sure'] },
            { label: 'Are there compliance or security requirements that apply?', kind: 'textarea' },
        ],
    },
    {
        id: 'backend',
        name: 'Custom Backend & Database System',
        questions: [
            { label: 'What data will the system store, and approximately how much?', kind: 'textarea', required: true, hint: 'For example: customer records and transactions, with a rough volume per month.' },
            { label: 'What will read from or write to it (for example a website, a mobile application, reports, other systems)?', kind: 'text' },
            { label: 'Is this a new build, or work on an existing system?', kind: 'select', options: ['New build', 'Existing system', 'Both'] },
            { label: 'Are there existing technologies or constraints I should be aware of?', kind: 'textarea' },
        ],
    },
    {
        id: 'audit',
        name: 'Code Audit, Security & Performance',
        questions: [
            { label: 'What has prompted this review?', kind: 'select', required: true, options: ['A security incident or concern', 'A compliance requirement', 'Performance problems', 'Pre-launch assurance', 'Other'] },
            { label: 'Which technologies is the system built on?', kind: 'textarea' },
            { label: 'What level of access can you provide?', kind: 'select', options: ['Source code', 'Running system only', 'Not yet decided'] },
            { label: 'Which areas are of greatest concern?', kind: 'textarea' },
        ],
    },
    {
        id: 'contract',
        name: 'Contract Engineering / Other',
        questions: [
            { label: 'What role or responsibilities would the engagement cover?', kind: 'textarea', required: true, hint: 'For example: backend development, cloud support, or a fixed-term project.' },
            { label: 'What is the expected duration and weekly time commitment?', kind: 'text' },
            { label: 'What is the size and structure of the team I would work with?', kind: 'text' },
            { label: 'Which technologies does the team use?', kind: 'text' },
        ],
    },
];
---

<section id="contact" class="contact-section reveal">
    <div class="wrap" style="width: 100%; display: flex; flex-direction: column; align-items: center;">
        <div class="section-header">
            <p class="eyebrow-num" style="margin-bottom: 8px;">09 / project inquiry</p>
            <h2><span class="highlight">Start</span> A Project</h2>
            <p>Please select a service and the level of detail you would like to provide. A detailed brief allows me to respond with a more accurate proposal; a brief enquiry is sufficient to begin a conversation.</p>
        </div>

        <div class="form-container" style="position: relative; overflow: hidden;">
            <!-- ColorBends Background -->
            <div style="position: absolute; inset: 0; z-index: 0; pointer-events: auto;">
                <ColorBends
                    client:only="react"
                    colors={["#e3a857", "#896ABD", "#1a0a2e"]}
                    rotation={90}
                    speed={0.2}
                    scale={1}
                    frequency={1}
                    warpStrength={1}
                    mouseInfluence={1}
                    noise={0.15}
                    parallax={0.5}
                    iterations={1}
                    intensity={0.9}
                    bandWidth={6}
                    transparent={true}
                />
            </div>

            <form action={FORMSPREE_URL} method="POST" id="contact-form" novalidate style="position: relative; z-index: 1; width: 100%;">
                <div id="form-body">

                <!-- Honeypot: hidden from people, bots fill it in. Formspree also discards _gotcha submissions. -->
                <div class="hp-field" aria-hidden="true">
                    <label for="website">Leave this field empty</label>
                    <input type="text" name="_gotcha" id="website" tabindex="-1" autocomplete="off" />
                </div>

                <div class="progress" id="progress" hidden>
                    <p class="progress-label" id="progress-label" aria-live="polite">Step 1 of 3</p>
                    <div class="progress-track" role="progressbar" aria-label="Form progress" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1">
                        <div class="progress-fill" id="progress-fill"></div>
                    </div>
                </div>

                <!-- STEP 1: about you and the service -->
                <div class="step" data-step="1" data-title="About you and your project">
                    <h3 class="step-title" tabindex="-1">About you and your project</h3>

                    <fieldset class="mode-picker">
                        <legend>Level of detail</legend>
                        <label class="mode-card">
                            <input type="radio" name="enquiry_type" value="Brief enquiry" data-label="Enquiry type" checked />
                            <span class="mode-title">Brief enquiry</span>
                            <span class="mode-desc">Approximately one minute. A short summary of what you require.</span>
                        </label>
                        <label class="mode-card">
                            <input type="radio" name="enquiry_type" value="Detailed project brief" data-label="Enquiry type" />
                            <span class="mode-title">Detailed project brief</span>
                            <span class="mode-desc">Approximately five minutes, in three short steps. Questions tailored to your service.</span>
                        </label>
                    </fieldset>

                    <div class="input-grid">
                        <div class="input-group">
                            <label for="name">Full Name</label>
                            <input type="text" name="name" id="name" data-label="Name" data-error="Please enter your full name." required autocomplete="name" />
                        </div>

                        <div class="input-group">
                            <label for="email">Email Address</label>
                            <input type="email" name="email" id="email" data-label="Email" data-error="Please enter a valid email address, for example name@company.com." required autocomplete="email" />
                        </div>
                    </div>

                    <div class="input-grid">
                        <div class="input-group">
                            <label for="service">Service Required</label>
                            <select name="service" id="service" data-label="Service" data-error="Please select the service you require." required>
                                <option value="" disabled selected>Select a service...</option>
                                {services.map((s) => <option value={s.name}>{s.name}</option>)}
                            </select>
                        </div>

                        <div class="input-group">
                            <label for="timeline">Estimated Timeline</label>
                            <select name="timeline" id="timeline" data-label="Timeline">
                                <option value="ASAP (under 1 month)">ASAP (under 1 month)</option>
                                <option value="1 - 3 months" selected>1 - 3 months</option>
                                <option value="Flexible / exploratory">Flexible / exploratory</option>
                                <option value="Ongoing contract retainer">Ongoing contract retainer</option>
                            </select>
                        </div>
                    </div>

                    <!-- Brief mode -->
                    <div class="mode-group" data-mode="brief">
                        <div class="input-group">
                            <label for="brief-message">What would you like to achieve?</label>
                            <textarea name="brief_message" id="brief-message" data-label="Summary" data-error="Please describe briefly what you would like to achieve." rows="4" required placeholder="A few sentences are sufficient."></textarea>
                        </div>
                    </div>
                </div>

                <!-- STEP 2: tailored questions -->
                <div class="step" data-step="2" data-title="Your project" hidden>
                    <h3 class="step-title" tabindex="-1">Your project</h3>
                    {services.map((s) => (
                        <div class="question-set" data-service={s.name} hidden>
                            {s.questions.map((q, i) => (
                                <div class="input-group">
                                    <label for={`q-${s.id}-${i}`}>{q.label}{!q.required && <span class="opt"> (optional)</span>}</label>
                                    {q.hint && <p class="hint" id={`hint-${s.id}-${i}`}>{q.hint}</p>}
                                    {q.kind === 'textarea' && (
                                        <textarea name={`q_${s.id}_${i}`} id={`q-${s.id}-${i}`} data-label={q.label} data-error="Please answer this question so that I can understand your requirements." rows="3" required={q.required} aria-describedby={q.hint ? `hint-${s.id}-${i}` : undefined} disabled></textarea>
                                    )}
                                    {q.kind === 'text' && (
                                        <input type="text" name={`q_${s.id}_${i}`} id={`q-${s.id}-${i}`} data-label={q.label} data-error="Please answer this question so that I can understand your requirements." required={q.required} aria-describedby={q.hint ? `hint-${s.id}-${i}` : undefined} disabled />
                                    )}
                                    {q.kind === 'select' && (
                                        <select name={`q_${s.id}_${i}`} id={`q-${s.id}-${i}`} data-label={q.label} data-error="Please select an option." required={q.required} aria-describedby={q.hint ? `hint-${s.id}-${i}` : undefined} disabled>
                                            <option value="" selected>{q.required ? 'Select an option...' : 'No preference stated'}</option>
                                            {q.options?.map((o) => <option value={o}>{o}</option>)}
                                        </select>
                                    )}
                                </div>
                            ))}
                        </div>
                    ))}
                </div>

                <!-- STEP 3: shared closing questions -->
                <div class="step" data-step="3" data-title="Final details" hidden>
                    <h3 class="step-title" tabindex="-1">Final details</h3>
                    <div class="common-set">
                        <div class="input-group">
                            <label for="q-success">What outcome would make this project a success for you?</label>
                            <textarea name="q_success" id="q-success" data-label="Definition of success" data-error="Please describe the outcome you are working towards." rows="3" required disabled></textarea>
                        </div>
                        <div class="input-group">
                            <label for="q-deadline">Is there a date by which this must be completed, and what determines that date?<span class="opt"> (optional)</span></label>
                            <input type="text" name="q_deadline" id="q-deadline" data-label="Deadline and reason" disabled />
                        </div>
                        <div class="input-grid">
                            <div class="input-group">
                                <label for="q-contact">Preferred method of contact</label>
                                <select name="q_contact" id="q-contact" data-label="Preferred contact method" disabled>
                                    <option value="Email" selected>Email</option>
                                    <option value="WhatsApp">WhatsApp</option>
                                    <option value="Telephone call">Telephone call</option>
                                </select>
                            </div>
                            <div class="input-group">
                                <label for="q-time">Best time to reach you<span class="opt"> (optional)</span></label>
                                <input type="text" name="q_time" id="q-time" data-label="Best time to reach" placeholder="e.g. weekdays after 14:00 SAST" disabled />
                            </div>
                        </div>
                    </div>
                </div>

                <p class="draft-note" id="draft-note" hidden>Your answers are saved on this device until you send them, so you can return later.</p>

                <div class="form-nav">
                    <button type="button" class="back-btn" id="btn-back" hidden>← Back</button>
                    <button type="button" class="submit-btn" id="btn-next" hidden>Continue →</button>
                    <button type="submit" class="submit-btn" id="btn-submit">Submit Enquiry →</button>
                </div>
                <p id="form-result" class="form-result" aria-live="polite"></p>

                </div>

                <!-- Shown after a successful send -->
                <div class="success-panel" id="success" hidden tabindex="-1">
                    <h3 id="success-title">Thank you.</h3>
                    <p>Your enquiry has been received. Here is what happens next:</p>
                    <ol>
                        <li>I review your enquiry and any detail you provided.</li>
                        <li>I reply by your preferred method of contact.</li>
                        <li>Where it would help, we arrange a phone call to agree scope and timeline.</li>
                    </ol>
                    <button type="button" class="back-btn" id="btn-again">Send another enquiry</button>
                </div>

                <div class="whatsapp-direct-box">
                    <span>Prefer immediate messaging?</span>
                    <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="whatsapp-link-btn" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                        </svg>
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

<style>
    .contact-section {
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .section-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .section-header p {
        color: var(--steel, #f4f6fc);
        max-width: 55ch;
        margin: 0 auto;
        font-size: 17px;
    }

    .form-container {
        width: 100%;
        max-width: 680px;
        background: rgba(26, 10, 46, 0.45);
        border: 1px solid rgba(227, 168, 87, 0.22);
        border-radius: 16px;
        padding: 2.5rem;
        backdrop-filter: blur(14px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    }

    .hp-field {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }

    .submit-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .input-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .input-group {
        margin-bottom: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    label {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: var(--steel, #f4f6fc);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    input, select, textarea {
        width: 100%;
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        padding: 0.9rem 1rem;
        color: var(--color-text, #ffffff);
        font-family: var(--font-sans);
        font-size: 0.95rem;
        transition: border-color 0.25s ease, background 0.25s ease;
    }

    select {
        cursor: pointer;
    }

    select option {
        background: #0f172a;
        color: #ffffff;
    }

    input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--color-primary, #e3a857);
        background: rgba(15, 23, 42, 0.95);
        box-shadow: 0 0 12px rgba(227, 168, 87, 0.25);
    }

    .submit-btn {
        width: 100%;
        background: var(--color-primary, #e3a857);
        color: var(--color-bg, #0f1b2d);
        border: none;
        border-radius: 8px;
        padding: 1rem;
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        margin-top: 0.75rem;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        background: #eab86c;
        box-shadow: 0 6px 16px rgba(227, 168, 87, 0.35);
    }

    .form-result {
        margin-top: 1rem;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 0.9rem;
    }

    .whatsapp-direct-box {
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        text-align: center;
    }

    .whatsapp-direct-box span {
        font-size: 17px;
        color: var(--steel, #f4f6fc);
        font-family: var(--font-mono);
    }

    .whatsapp-link-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border-radius: 6px;
        text-decoration: none;
        background: rgba(227, 168, 87, 0.08);
        border: 1px solid rgba(227, 168, 87, 0.4);
        color: var(--amber, #e3a857);
        transition: all 0.2s ease;
    }

    .whatsapp-link-btn:hover,
    .whatsapp-link-btn:focus-visible {
        background: rgba(37, 211, 102, 0.16);
        border-color: #25d366;
        color: #25d366;
        box-shadow: 0 0 16px rgba(37, 211, 102, 0.4);
        transform: translateY(-1px);
    }

    .mode-picker {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        border: none;
        margin: 0 0 1.5rem;
        padding: 0;
    }

    .mode-picker legend {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: var(--steel, #f4f6fc);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0;
        margin-bottom: 0.5rem;
    }

    .mode-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 0.9rem 1rem 0.9rem 2.4rem;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        cursor: pointer;
        text-transform: none;
        letter-spacing: normal;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

    .mode-card input {
        position: absolute;
        left: 1rem;
        top: 1.05rem;
        width: auto;
        margin: 0;
        accent-color: var(--color-primary, #e3a857);
    }

    .mode-card:has(input:checked) {
        border-color: var(--color-primary, #e3a857);
        background: rgba(227, 168, 87, 0.1);
    }

    .mode-card:has(input:focus-visible) {
        outline: 2px solid var(--color-primary, #e3a857);
        outline-offset: 2px;
    }

    .mode-title {
        font-family: var(--font-heading);
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-text, #ffffff);
    }

    .mode-desc {
        font-family: var(--font-sans);
        font-size: 0.85rem;
        line-height: 1.4;
        color: var(--steel, #f4f6fc);
        opacity: 0.85;
    }

    .mode-hint {
        margin: 0 0 1.25rem;
        font-size: 0.9rem;
        color: var(--steel, #f4f6fc);
        opacity: 0.85;
    }

    .opt {
        text-transform: none;
        letter-spacing: normal;
        opacity: 0.7;
    }

    textarea {
        resize: vertical;
    }

    @media (max-width: 600px) {
        .mode-picker {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .input-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }
        .form-container {
            padding: 1.75rem 1.25rem;
        }
    }

    /* ---- Guided form: readability, steps, progress, feedback ---- */
    .form-container {
        background: rgba(14, 8, 28, 0.82);
        scroll-margin-top: 96px;
    }

    #form-body,
    .success-panel,
    .whatsapp-direct-box {
        background: rgba(14, 8, 28, 0.66);
        backdrop-filter: blur(8px);
        border-radius: 12px;
        padding: 1.25rem;
    }

    .whatsapp-direct-box {
        margin-top: 1rem;
        padding: 1rem;
        border-top: none;
    }

    .step[hidden],
    .mode-group[hidden],
    .question-set[hidden] {
        display: none;
    }

    .step-title {
        display: none;
        margin: 0 0 1.25rem;
        font-family: var(--font-heading);
        font-size: 1.25rem;
        color: var(--color-text, #ffffff);
        outline: none;
    }

    #contact-form.is-detailed .step-title {
        display: block;
    }

    .progress {
        margin-bottom: 1.5rem;
    }

    .progress-label {
        margin: 0 0 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: var(--amber, #e3a857);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .progress-track {
        height: 4px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 2px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        width: 33%;
        background: var(--color-primary, #e3a857);
        transition: width 0.3s ease;
    }

    .hint {
        margin: -0.25rem 0 0;
        font-size: 0.85rem;
        color: var(--steel, #f4f6fc);
        opacity: 0.75;
    }

    .draft-note {
        margin: 0.25rem 0 0;
        font-size: 0.85rem;
        color: var(--steel, #f4f6fc);
        opacity: 0.75;
    }

    .form-nav {
        display: flex;
        gap: 12px;
        margin-top: 0.75rem;
    }

    .form-nav .submit-btn {
        flex: 1;
        margin-top: 0;
    }

    .form-nav [hidden] {
        display: none;
    }

    .back-btn {
        background: transparent;
        color: var(--color-text, #ffffff);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        font-family: var(--font-heading);
        font-size: 1rem;
        cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease;
    }

    .back-btn:hover,
    .back-btn:focus-visible {
        border-color: var(--color-primary, #e3a857);
        color: var(--color-primary, #e3a857);
    }

    input[aria-invalid="true"],
    select[aria-invalid="true"],
    textarea[aria-invalid="true"] {
        border-color: #ef4444;
    }

    .field-error {
        margin: 0;
        font-size: 0.85rem;
        color: #fca5a5;
    }

    .success-panel {
        padding: 0.5rem 0;
        outline: none;
    }

    .success-panel[hidden] {
        display: none;
    }

    .success-panel h3 {
        margin: 0 0 0.75rem;
        font-family: var(--font-heading);
        font-size: 1.5rem;
        color: var(--color-text, #ffffff);
    }

    .success-panel p,
    .success-panel li {
        color: var(--steel, #f4f6fc);
        line-height: 1.6;
    }

    .success-panel ol {
        margin: 0.75rem 0 1.5rem;
        padding-left: 1.25rem;
    }

    @media (max-width: 600px) {
        .form-nav {
            flex-direction: column-reverse;
        }
    }
</style>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;

    if (form) {
        const DRAFT_KEY = 'sbk-contact-draft';
        const MIN_FILL_MS = 3000;
        const loadedAt = Date.now();
        let hideTimer: number | undefined;
        let saveTimer: number | undefined;
        let step = 1;

        type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

        const $ = <T extends HTMLElement>(sel: string) => form.querySelector<T>(sel)!;
        const result = $('#form-result');
        const body = $('#form-body');
        const success = $('#success');
        const service = $<HTMLSelectElement>('#service');
        const steps = Array.from(form.querySelectorAll<HTMLElement>('.step'));
        const sets = Array.from(form.querySelectorAll<HTMLElement>('.question-set'));
        const briefGroup = $('[data-mode="brief"]');
        const commonSet = $('.common-set');
        const progress = $('#progress');
        const progressLabel = $('#progress-label');
        const progressFill = $('#progress-fill');
        const progressTrack = $('.progress-track');
        const draftNote = $('#draft-note');
        const btnBack = $<HTMLButtonElement>('#btn-back');
        const btnNext = $<HTMLButtonElement>('#btn-next');
        const btnSubmit = $<HTMLButtonElement>('#btn-submit');

        const isDetailed = () =>
            form.querySelector<HTMLInputElement>('input[name="enquiry_type"]:checked')?.value === 'Detailed project brief';
        const totalSteps = () => (isDetailed() ? 3 : 1);

        function show(message: string, color: string) {
            window.clearTimeout(hideTimer);
            result.textContent = message;
            result.style.display = 'block';
            result.style.color = color;
        }

        // Fields in hidden groups are also disabled, so they are neither validated nor sent.
        function toggle(el: Element, on: boolean) {
            (el as HTMLElement).hidden = !on;
            el.querySelectorAll<Field>('input, select, textarea').forEach((f) => {
                f.disabled = !on;
                if (!on) clearError(f);
            });
        }

        function update() {
            const detailed = isDetailed();
            const chosen = service.value;
            form.classList.toggle('is-detailed', detailed);
            toggle(briefGroup, !detailed);
            sets.forEach((s) => toggle(s, detailed && s.dataset.service === chosen));
            toggle(commonSet, detailed && chosen !== '');
            draftNote.hidden = !detailed;
            if (step > totalSteps()) step = 1;
            showStep(step, false);
        }

        function showStep(n: number, moveFocus: boolean) {
            step = n;
            const total = totalSteps();
            const detailed = isDetailed();
            steps.forEach((s) => (s.hidden = Number(s.dataset.step) !== n));
            progress.hidden = !detailed;
            if (detailed) {
                const title = steps[n - 1].dataset.title ?? '';
                progressLabel.textContent = `Step ${n} of ${total}: ${title}`;
                progressFill.style.width = `${(n / total) * 100}%`;
                progressTrack.setAttribute('aria-valuenow', String(n));
            }
            btnBack.hidden = n === 1;
            btnNext.hidden = n === total;
            btnSubmit.hidden = n !== total;
            if (moveFocus) {
                form.closest('.form-container')?.scrollIntoView({ block: 'start' });
                steps[n - 1].querySelector<HTMLElement>('.step-title')?.focus({ preventScroll: true });
            }
        }

        // ---------- validation ----------
        function clearError(f: Field) {
            f.removeAttribute('aria-invalid');
            const err = f.parentElement?.querySelector('.field-error');
            if (err) {
                f.setAttribute('aria-describedby', (f.getAttribute('aria-describedby') ?? '').split(' ').filter((id) => id && id !== err.id).join(' '));
                if (!f.getAttribute('aria-describedby')) f.removeAttribute('aria-describedby');
                err.remove();
            }
        }

        function setError(f: Field, message: string) {
            clearError(f);
            f.setAttribute('aria-invalid', 'true');
            const err = document.createElement('p');
            err.className = 'field-error';
            err.id = `err-${f.id}`;
            err.setAttribute('role', 'alert');
            err.textContent = message;
            f.insertAdjacentElement('afterend', err);
            f.setAttribute('aria-describedby', `${f.getAttribute('aria-describedby') ?? ''} ${err.id}`.trim());
        }

        function checkField(f: Field): boolean {
            if (f.disabled || !f.required) return true;
            const value = f.value.trim();
            let message = '';
            if (value === '') message = f.dataset.error || 'This field is required.';
            else if (f.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) message = f.dataset.error || 'Please enter a valid email address.';
            if (message) {
                setError(f, message);
                return false;
            }
            clearError(f);
            return true;
        }

        function validateStep(n: number): boolean {
            const fields = Array.from(steps[n - 1].querySelectorAll<Field>('input, select, textarea'));
            let firstBad: Field | undefined;
            for (const f of fields) {
                if (!checkField(f) && !firstBad) firstBad = f;
            }
            firstBad?.focus();
            return !firstBad;
        }

        form.addEventListener('focusout', (e) => {
            const f = e.target as Field;
            if (f.matches?.('input, select, textarea') && f.required && f.value.trim() !== '') checkField(f);
        });

        form.addEventListener('input', (e) => {
            const f = e.target as Field;
            if (f.getAttribute?.('aria-invalid') === 'true') clearError(f);
            if (f instanceof HTMLTextAreaElement) {
                f.style.height = 'auto';
                f.style.height = `${f.scrollHeight}px`;
            }
            queueSave();
        });

        form.addEventListener('change', (e) => {
            const t = e.target as HTMLElement;
            if (t.matches('input[name="enquiry_type"]') || t.id === 'service') update();
            queueSave();
        });

        // ---------- draft autosave (per device) ----------
        function queueSave() {
            window.clearTimeout(saveTimer);
            saveTimer = window.setTimeout(saveDraft, 400);
        }

        function saveDraft() {
            if (!success.hidden) return;
            try {
                const data: Record<string, string> = {};
                form.querySelectorAll<Field>('input[name], select[name], textarea[name]').forEach((f) => {
                    if (f.name === '_gotcha') return;
                    if (f instanceof HTMLInputElement && f.type === 'radio') {
                        if (f.checked) data[f.name] = f.value;
                    } else if (f.value) {
                        data[f.name] = f.value;
                    }
                });
                localStorage.setItem(DRAFT_KEY, JSON.stringify(data));
            } catch {}
        }

        function clearDraft() {
            try {
                localStorage.removeItem(DRAFT_KEY);
            } catch {}
        }

        function restoreDraft() {
            try {
                const raw = localStorage.getItem(DRAFT_KEY);
                if (!raw) return;
                const data = JSON.parse(raw) as Record<string, string>;
                for (const [name, value] of Object.entries(data)) {
                    form.querySelectorAll<Field>(`[name="${name}"]`).forEach((f) => {
                        if (f instanceof HTMLInputElement && f.type === 'radio') f.checked = f.value === value;
                        else f.value = value;
                    });
                }
                form.querySelectorAll('textarea').forEach((t) => {
                    t.style.height = 'auto';
                    if (t.value) t.style.height = `${t.scrollHeight}px`;
                });
            } catch {}
        }

        // ---------- navigation ----------
        btnNext.addEventListener('click', () => {
            if (validateStep(step)) showStep(step + 1, true);
        });
        btnBack.addEventListener('click', () => showStep(step - 1, true));

        $('#btn-again').addEventListener('click', () => {
            success.hidden = true;
            body.hidden = false;
            step = 1;
            update();
            form.closest('.form-container')?.scrollIntoView({ block: 'start' });
        });

        // ---------- submit ----------
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (btnSubmit.disabled) return;

            // Enter on an earlier step moves forward instead of submitting.
            if (step < totalSteps()) {
                if (validateStep(step)) showStep(step + 1, true);
                return;
            }
            if (!validateStep(step)) return;

            const entries = new FormData(form); // excludes disabled fields
            const name = String(entries.get('name') ?? '').trim();
            const firstName = name.split(/\s+/)[0] || 'there';

            // Bots fill the honeypot or submit instantly; pretend success and drop it.
            if (entries.get('_gotcha') || Date.now() - loadedAt < MIN_FILL_MS) {
                finish(firstName);
                return;
            }

            // Send human-readable labels so the notification email reads like a brief.
            const payload: Record<string, string> = {};
            for (const [key, value] of entries) {
                if (key === '_gotcha' || typeof value !== 'string' || value.trim() === '') continue;
                const field = form.querySelector<HTMLElement>(`[name="${key}"]`);
                payload[field?.dataset.label || key] = value.trim();
            }
            payload['email'] = String(entries.get('email') ?? '').trim();
            payload['_subject'] = `${isDetailed() ? 'Detailed brief' : 'Enquiry'}: ${service.value} (${name || 'unknown'})`;

            btnSubmit.disabled = true;
            const label = btnSubmit.textContent;
            btnSubmit.textContent = 'Sending...';
            show('', 'inherit');

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify(payload),
                });
                const data = await response.json().catch(() => ({}));

                if (response.ok) {
                    finish(firstName);
                } else if (Array.isArray(data.errors)) {
                    show(data.errors.map((err: { message: string }) => err.message).join(', '), '#ef4444');
                } else {
                    show('There was a problem submitting your enquiry. Please try again, or contact me on WhatsApp.', '#ef4444');
                }
            } catch {
                show('Your enquiry could not be sent. Please check your connection and try again, or contact me on WhatsApp.', '#ef4444');
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.textContent = label;
                hideTimer = window.setTimeout(() => {
                    result.style.display = 'none';
                }, 10000);
            }
        });

        function finish(firstName: string) {
            clearDraft();
            form.reset();
            form.querySelectorAll('textarea').forEach((t) => (t.style.height = ''));
            step = 1;
            update();
            result.style.display = 'none';
            $('#success-title').textContent = `Thank you, ${firstName}.`;
            body.hidden = true;
            success.hidden = false;
            form.closest('.form-container')?.scrollIntoView({ block: 'start' });
            success.focus({ preventScroll: true });
        }

        restoreDraft();
        update();
    }
</script>

---
interface Props {
	class?: string;
}

const { class: className = '' }: Props = Astro.props;
---

<div class={`crest-wrap ${className}`} aria-hidden="true">
	<div class="crest">
		<div class="tri">
			<div class="line"></div>
			<div class="line left"></div>
			<div class="line right"></div>
		</div>
		<div class="sqHolder">
			<div class="sq left"></div>
			<div class="sq top"></div>
			<div class="sq right"></div>
		</div>
	</div>
</div>

<style>
	.crest-wrap {
		position: relative;
		width: 100%;
		height: 50vh;
		aspect-ratio: 1 / 1;
		display: flex;
		align-items: center;
		justify-content: center;
		perspective: 1440px;
	}

	.crest {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		animation: crestRotate 10s linear infinite;
		animation-delay: 5s;
	}

	.tri {
		position: relative;
		width: 100%;
		height: 100%;
		transform: translate3d(0, -5vh, 0);
		transform-style: preserve-3d;
	}

	.line {
		position: absolute;
		width: 112.5%;
		height: 4px;
		background: var(--paper);
		bottom: 0;
		opacity: 0;
		transform: translate3d(0, 50%, 0);
		border-radius: 4px;
		animation:
			renderOpacityOn 0.2s linear 4s forwards,
			revealFlicker 0.5s linear 6 0.3s;
	}
	.line::after {
		content: '';
		position: absolute;
		width: 100%;
		height: 100%;
		background: inherit;
		filter: blur(15px);
		opacity: 0.7;
	}

	.line.left {
		transform-origin: left;
		rotate: -63.435deg;
		width: 125%;
		transform: translate3d(-11%, 11%, 0);
		animation-delay: 4.1s, 0.5s;
	}

	.line.right {
		transform-origin: right;
		rotate: 63.435deg;
		right: 0;
		width: 125%;
		animation-delay: 4.2s, 0.7s;
	}

	.sqHolder {
		position: absolute;
		width: 100%;
		height: 100%;
		top: 0;
		opacity: 0;
		transform: translate3d(0, -5vh, 0);
		animation: revealOpacity 0.2s linear 4s forwards;
	}

	.sq {
		position: absolute;
		width: 15%;
		top: 100%;
		aspect-ratio: 1 / 1;
		background: var(--ink);
		border: 1px solid var(--paper);
		box-shadow: 0 0 15px rgba(240, 240, 240, 0.68);
		transform: translate3d(-50%, -50%, 0);
		border-radius: 50%;
		animation-duration: 2s, 0.2s, 0.2s;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
	}

	.sq.left {
		animation-name: sqLeft, renderBoxShadow, renderBorder;
		animation-delay: 5s, 0.1s, 0.1s;
	}

	.sq.top {
		top: 0;
		left: 50%;
		animation-name: sqTop, renderBoxShadow, renderBorder;
		animation-delay: 5s, 0.2s, 0.2s;
	}

	.sq.right {
		left: 100%;
		animation-name: sqRight, renderBoxShadow, renderBorder;
		animation-delay: 5s, 0.3s, 0.3s;
	}

	/* keyframes */
	@keyframes crestRotate {
		100% {
			transform: rotate3d(0, 0, 1, 360deg);
		}
	}

	@keyframes renderOpacityOn {
		100% {
			opacity: 1;
		}
	}

	@keyframes renderBoxShadow {
		100% {
			box-shadow: 0 0 15px transparent;
		}
	}

	@keyframes renderBorder {
		100% {
			border-color: transparent;
		}
	}

	@keyframes revealOpacity {
		100% {
			opacity: 1;
		}
	}

	@keyframes revealFlicker {
		0% {
			opacity: 0;
		}
		50% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	@keyframes sqLeft {
		0%, 100% {
			transform: translate3d(0, 0, 0);
		}
		33.3% {
			transform: translate3d(25vh, -50vh, 0);
		}
		66.6% {
			transform: translate3d(50vh, 0, 0);
		}
	}

	@keyframes sqTop {
		0%, 100% {
			transform: translate3d(0, 0, 0);
		}
		33.3% {
			transform: translate3d(25vh, 50vh, 0);
		}
		66.6% {
			transform: translate3d(-25vh, 50vh, 0);
		}
	}

	@keyframes sqRight {
		0%, 100% {
			transform: translate3d(0, 0, 0);
		}
		33.3% {
			transform: translate3d(-50vh, 0, 0);
		}
		66.6% {
			transform: translate3d(-25vh, -50vh, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.crest,
		.line,
		.sq,
		.sqHolder {
			animation: none !important;
			opacity: 1 !important;
		}
	}
</style>

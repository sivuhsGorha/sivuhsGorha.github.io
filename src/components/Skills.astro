---
import AccordionGallery from './reactbits/AccordionGallery.jsx';
import TechStackGrid from './TechStackGrid.jsx';

const skillItems = [
  { label: 'Languages', skills: ['Java', 'PHP', 'JavaScript', 'TypeScript', 'C', 'HTML5', 'CSS3'] },
  { label: 'Frontend', skills: ['React', 'Astro', 'Responsive UI'] },
  { label: 'Backend & Cloud', skills: ['Node.js', 'Docker', 'Nginx', 'AWS (VPC, EC2, CI/CD)'] },
  { label: 'Databases', skills: ['MySQL', 'Microsoft SQL Server', 'Data modelling'] },
  { label: 'Mobile', skills: ['Android app development'] },
  { label: 'Security', skills: ['CompTIA A+ (2024)', 'CompTIA Security+', 'Secure coding'] },
  { label: 'Networking', skills: ['Fibre installation', 'Network configuration', 'LAN & cabling'] },
  { label: 'Process', skills: ['Agile / Scrum', 'Software testing', 'Requirements analysis'] }
];
---

<section id="skills" class="reveal">
    <div class="wrap">
        <p class="eyebrow-num">04 / skills & tech stack</p>
        <h2>What I work with</h2>
        <p class="skills-intro">
            What I use day to day, grouped by area.
        </p>

        <!-- Skills accordion -->
        <div class="gallery-wrapper">
            <AccordionGallery
                client:only="react"
                items={skillItems}
                defaultIndex={0}
                expandRatio={0.46}
                trigger="hover"
                height={260}
                gap={6}
                radius={4}
                accentColor="#e3a857"
                overlayColor="transparent"
                textColor="#ffffff"
                showLabels={true}
                duration={0.45}
                tilt={4}
                parallax={0.3}
            />
        </div>

        <!-- Interactive Tech Stack Matrix with Official Badges & Filtering -->
        <div class="tech-stack-section">
            <div class="tech-stack-header">
                <div>
                    <p class="eyebrow-num" style="margin-bottom: 4px;">tools</p>
                    <h3 class="tech-stack-heading">Tools</h3>
                </div>
                <p class="tech-stack-sub">
                    Filter by area.
                </p>
            </div>

            <TechStackGrid client:load />
        </div>
    </div>
</section>

<style>
    .skills-intro {
        color: var(--steel, #f4f6fc);
        font-size: 20px;
        max-width: 65ch;
        margin-top: -16px;
        margin-bottom: 32px;
        line-height: 1.6;
    }

    .gallery-wrapper {
        margin-bottom: 56px;
    }

    .tech-stack-section {
        border-top: 1px solid var(--line, #33465c);
        padding-top: 48px;
    }

    .tech-stack-header {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 24px;
    }

    .tech-stack-heading {
        font-family: 'Fraunces', serif;
        font-size: 32px;
        font-weight: 500;
        color: var(--paper, #ffffff);
    }

    .tech-stack-sub {
        color: var(--steel, #f4f6fc);
        font-size: 16.5px;
        margin: 0;
        max-width: 60ch;
    }
</style>

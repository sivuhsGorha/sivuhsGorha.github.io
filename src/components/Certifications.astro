---
// Certifications.astro — Verified Credentials & Academic Accreditations
---

<section id="certifications" class="certifications reveal">
    <div class="wrap">
        <div class="section-header">
            <p class="eyebrow-num" style="margin-bottom: 8px;">04 / credentials & education</p>
            <h2><span class="highlight">Cert</span>ifications</h2>
            <p>Verified industry credentials & academic distinction.</p>
        </div>

        <div class="cert-grid">
            <!-- CompTIA Security+ -->
            <div class="cert-card">
                <div class="card-glow-bg sec-glow" aria-hidden="true"></div>
                <div class="cert-inner">
                    <div class="cert-icon sec-plus">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                            <path d="M12 8v4"/>
                            <path d="M12 16h.01"/>
                        </svg>
                    </div>
                    <div class="cert-details">
                        <h3>CompTIA Security+</h3>
                        <p>Cybersecurity Fundamentals & Network Hardening</p>
                        <span class="cert-date">Valid Credential</span>
                    </div>
                </div>
            </div>

            <!-- CompTIA A+ -->
            <div class="cert-card">
                <div class="card-glow-bg a-glow" aria-hidden="true"></div>
                <div class="cert-inner">
                    <div class="cert-icon a-plus">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2"/>
                            <path d="M9 10v4"/>
                            <path d="M15 10v4"/>
                            <path d="M9 14h6"/>
                            <path d="M12 7v3"/>
                        </svg>
                    </div>
                    <div class="cert-details">
                        <h3>CompTIA A+</h3>
                        <p>IT Operations, Hardware & System Infrastructure</p>
                        <span class="cert-date">Issued 2024</span>
                    </div>
                </div>
            </div>

            <!-- Boston City Campus -->
            <div class="cert-card featured">
                <div class="card-glow-bg diploma-glow" aria-hidden="true"></div>
                <div class="cert-inner">
                    <div class="cert-icon diploma">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                        </svg>
                    </div>
                    <div class="cert-details">
                        <h3>Diploma in Systems Development</h3>
                        <p>Boston City Campus (HDIPSD2)</p>
                        <span class="cert-date distinction">76% Distinction Pass</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .certifications {
        margin: 8rem 0;
    }

    .section-header {
        margin-bottom: 3rem;
    }

    .cert-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .cert-card {
        position: relative;
        background: rgba(22, 12, 38, 0.55);
        border: 1px solid rgba(227, 168, 87, 0.18);
        border-radius: 16px;
        padding: 1.75rem 1.5rem;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        overflow: hidden;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .cert-card:hover {
        border-color: rgba(227, 168, 87, 0.45);
        transform: translateY(-3px);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.4), 0 0 20px rgba(227, 168, 87, 0.12);
    }

    .cert-card.featured {
        border-color: rgba(227, 168, 87, 0.35);
        background: linear-gradient(135deg, rgba(28, 14, 48, 0.7) 0%, rgba(14, 10, 24, 0.6) 100%);
    }

    .card-glow-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .sec-glow {
        background: radial-gradient(circle at 90% 10%, rgba(239, 68, 68, 0.12) 0%, transparent 70%);
    }

    .a-glow {
        background: radial-gradient(circle at 90% 10%, rgba(59, 130, 246, 0.12) 0%, transparent 70%);
    }

    .diploma-glow {
        background: radial-gradient(circle at 90% 10%, rgba(227, 168, 87, 0.16) 0%, rgba(137, 106, 189, 0.1) 50%, transparent 75%);
    }

    .cert-card:hover .card-glow-bg {
        opacity: 1.5;
    }

    .cert-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .cert-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(15, 23, 42, 0.65);
        flex-shrink: 0;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .cert-icon.sec-plus {
        color: #ef4444;
        background: rgba(239, 68, 68, 0.1);
        border-color: rgba(239, 68, 68, 0.25);
    }

    .cert-icon.a-plus {
        color: #3b82f6;
        background: rgba(59, 130, 246, 0.1);
        border-color: rgba(59, 130, 246, 0.25);
    }

    .cert-icon.diploma {
        color: var(--color-primary, #e3a857);
        background: rgba(227, 168, 87, 0.12);
        border-color: rgba(227, 168, 87, 0.3);
    }

    .cert-details h3 {
        font-family: var(--font-heading, 'Fraunces', serif);
        font-size: 1.15rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
        color: var(--color-text, #ffffff);
    }

    .cert-details p {
        font-size: 0.88rem;
        color: var(--steel, #a9bcdc);
        margin-bottom: 0.5rem;
        line-height: 1.45;
    }

    .cert-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        background: rgba(10, 5, 20, 0.5);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        color: var(--steel, #a9bcdc);
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: inline-block;
    }

    .cert-date.distinction {
        background: rgba(227, 168, 87, 0.14);
        color: var(--amber, #e3a857);
        font-weight: 600;
        border: 1px solid rgba(227, 168, 87, 0.35);
    }
</style>


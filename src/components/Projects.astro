---
import { projects } from '../data/projects';
---

<section id="projects" class="reveal">
    <div class="wrap">
        <p class="eyebrow-num">04 / projects</p>
        <h2>Selected work</h2>
        {
            projects.map((project) => (
                <div class="project">
                    <div class="pid">{project.id}</div>
                    <div>
                        <h3>{project.title}</h3>
                        <p>{project.summary}</p>
                        <div class="stack">
                            {project.stack.map((item) => (
                                <span>{item}</span>
                            ))}
                        </div>
                        <div class="project-links">
                            <a class="project-link" href={project.repoUrl}>
                                View repository →
                            </a>
                            {project.liveUrl && (
                                <a class="project-link" href={project.liveUrl}>
                                    Live site →
                                </a>
                            )}
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</section>

---
import { projects } from '../data/projects';
---

<section id="projects" class="reveal projects-section">
    <div class="wrap">
        <p class="eyebrow-num">05 / selected work & client projects</p>
        <div class="projects-header">
            <h2>Selected Work</h2>
            <p class="projects-sub">
                Real-world client deliverables and production systems engineered for reliability, security, and measurable business value.
            </p>
        </div>

        <div class="projects-list">
            {
                projects.map((project) => (
                    <div class="project-card">
                        <div class="project-sidebar">
                            <span class="pid">{project.id}</span>
                            {project.badge && <span class="client-badge">{project.badge}</span>}
                        </div>
                        <div class="project-content">
                            <div class="project-title-row">
                                <h3>{project.title}</h3>
                                {project.client && <span class="client-name">Client: {project.client}</span>}
                            </div>
                            <p class="project-summary">{project.summary}</p>
                            
                            {project.metrics && project.metrics.length > 0 && (
                                <div class="project-metrics">
                                    {project.metrics.map((metric) => (
                                        <span class="metric-badge">{metric}</span>
                                    ))}
                                </div>
                            )}

                            {project.deliverables && project.deliverables.length > 0 && (
                                <div class="project-deliverables">
                                    <p class="deliv-label">Delivered Scope:</p>
                                    <ul>
                                        {project.deliverables.map((item) => (
                                            <li>
                                                <span class="bullet">✓</span>
                                                <span>{item}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}

                            {project.architectureDiagram && (
                                <div class="arch-diagram-box">
                                    <div class="arch-diagram-header">
                                        <span class="arch-tag">Architecture Flowchart</span>
                                        <p class="arch-title">System Architecture Topology</p>
                                    </div>
                                    <div class="arch-flowchart-canvas">
                                        {project.architectureDiagram.nodes.map((node, i) => (
                                            <div class="arch-step-wrap">
                                                <div class={`arch-node-box node-type-${node.type}`}>
                                                    <div class="node-step-badge">STEP 0{i + 1}</div>
                                                    <div class="node-label-text">{node.label}</div>
                                                </div>
                                                {i < project.architectureDiagram.nodes.length - 1 && (
                                                    <div class="arch-connector">
                                                        <span class="connector-line-h"></span>
                                                        <span class="connector-arrow-h">►</span>
                                                        <div class="connector-v">
                                                            <span class="connector-line-v"></span>
                                                            <span class="connector-arrow-v">▼</span>
                                                        </div>
                                                    </div>
                                                )}
                                            </div>
                                        ))}
                                    </div>
                                    <div class="arch-flow-footer">
                                        <span class="flow-label">Data Pipeline:</span>
                                        <span class="arch-flow-summary">{project.architectureDiagram.flow}</span>
                                    </div>
                                </div>
                            )}

                            {project.architectureDeepDive && (
                                <details class="arch-deep-dive">
                                    <summary class="deep-dive-trigger">
                                        <span>Technical Deep-Dive & Architecture Breakdown</span>
                                        <span class="trigger-icon">+</span>
                                    </summary>
                                    <div class="deep-dive-body">
                                        <p><strong>Overview:</strong> {project.architectureDeepDive.overview}</p>
                                        {project.architectureDeepDive.schemaHighlights && (
                                            <p><strong>Data & Schema Architecture:</strong> {project.architectureDeepDive.schemaHighlights}</p>
                                        )}
                                        {project.architectureDeepDive.securityFocus && (
                                            <p><strong>Security & Resilience:</strong> {project.architectureDeepDive.securityFocus}</p>
                                        )}
                                    </div>
                                </details>
                            )}

                            <div class="stack">
                                {project.stack.map((item) => (
                                    <span>{item}</span>
                                ))}
                            </div>
                            <div class="project-links">
                                {project.liveUrl && (
                                    <a class="btn-live" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
                                        Visit Live Website ↗
                                    </a>
                                )}
                                {project.repoUrl && (
                                    <a class="btn-repo" href={project.repoUrl} target="_blank" rel="noopener noreferrer">
                                        View Repository on GitHub →
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Project Inquiry Callout -->
        <div class="project-cta-banner">
            <div class="banner-content">
                <h3>Have a project in mind or need AWS cloud infrastructure?</h3>
                <p>
                    I am actively taking on select freelance contracts, web application builds, and AWS cloud migrations. Let's discuss your timeline and technical requirements.
                </p>
            </div>
            <a href="#contact" class="btn btn-primary banner-btn">Start a Project Inquiry →</a>
        </div>
    </div>
</section>

<style>
    .projects-header {
        margin-bottom: 32px;
    }
    .projects-sub {
        color: var(--steel, #f4f6fc);
        font-size: 20px;
        max-width: 65ch;
        margin-top: -16px;
        line-height: 1.6;
    }
    .projects-list {
        display: flex;
        flex-direction: column;
        gap: 32px;
        margin-bottom: 56px;
    }
    .project-card {
        background: rgba(14, 10, 24, 0.55);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(227, 168, 87, 0.18);
        border-radius: 8px;
        padding: 32px;
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 32px;
        transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .project-card:hover {
        border-color: rgba(227, 168, 87, 0.45);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    }
    .project-sidebar {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .pid {
        font-family: 'JetBrains Mono', monospace;
        color: var(--amber);
        font-size: 17px;
        font-weight: 600;
    }
    .client-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        font-weight: 600;
        color: var(--amber);
        background: rgba(227, 168, 87, 0.1);
        border: 1px solid rgba(227, 168, 87, 0.25);
        padding: 4px 8px;
        border-radius: 4px;
        display: inline-block;
        line-height: 1.3;
    }
    .project-title-row {
        margin-bottom: 12px;
    }
    .project-title-row h3 {
        font-size: 26px;
        color: var(--paper, #fff);
        margin-bottom: 4px;
    }
    .client-name {
        font-family: 'JetBrains Mono', monospace;
        font-size: 17px;
        color: var(--amber);
    }
    .project-summary {
        color: var(--steel, #f4f6fc);
        font-size: 17px;
        line-height: 1.65;
        margin-bottom: 20px;
    }
    .project-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 20px;
    }
    .metric-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: #e3a857;
        background: rgba(227, 168, 87, 0.08);
        border: 1px solid rgba(227, 168, 87, 0.25);
        padding: 4px 10px;
        border-radius: 4px;
    }
    .arch-diagram-box {
        background: radial-gradient(circle at top left, rgba(26, 10, 46, 0.75), rgba(8, 4, 18, 0.95));
        border: 1px solid rgba(168, 85, 247, 0.35);
        border-radius: 8px;
        padding: 20px 24px;
        margin-bottom: 24px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }
    .arch-diagram-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }
    .arch-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: rgba(227, 168, 87, 0.15);
        color: var(--amber, #e3a857);
        border: 1px solid rgba(227, 168, 87, 0.4);
        padding: 3px 8px;
        border-radius: 3px;
    }
    .arch-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: #d8b4fe;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0;
    }
    .arch-flowchart-canvas {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        gap: 0;
        margin-bottom: 16px;
        padding: 18px 16px;
        background: rgba(0, 0, 0, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        overflow-x: auto;
    }
    .arch-step-wrap {
        display: flex;
        align-items: center;
        flex: 1;
    }
    .arch-step-wrap:last-child {
        flex: 0 1 auto;
    }
    .arch-node-box {
        display: flex;
        flex-direction: column;
        gap: 6px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.14);
        padding: 12px 14px;
        border-radius: 6px;
        flex: 1;
        min-width: 140px;
        box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.02);
    }
    .node-step-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: rgba(227, 168, 87, 0.85);
        letter-spacing: 0.05em;
    }
    .node-label-text {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        font-weight: 500;
        color: #ffffff;
        line-height: 1.35;
    }
    .node-type-client { border-color: rgba(59, 130, 246, 0.45); background: rgba(59, 130, 246, 0.08); }
    .node-type-gateway { border-color: rgba(34, 197, 94, 0.45); background: rgba(34, 197, 94, 0.08); }
    .node-type-app { border-color: rgba(227, 168, 87, 0.45); background: rgba(227, 168, 87, 0.08); }
    .node-type-db { border-color: rgba(168, 85, 247, 0.45); background: rgba(168, 85, 247, 0.08); }
    .node-type-cloud { border-color: rgba(14, 165, 233, 0.45); background: rgba(14, 165, 233, 0.08); }
    .arch-connector {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 10px;
        color: var(--amber, #e3a857);
        flex-shrink: 0;
    }
    .connector-line-h {
        width: 18px;
        height: 2px;
        background: linear-gradient(90deg, rgba(227, 168, 87, 0.3), rgba(227, 168, 87, 0.9));
    }
    .connector-arrow-h {
        font-size: 11px;
        margin-left: -2px;
    }
    .connector-v {
        display: none;
    }

    @media (max-width: 900px) {
        .arch-flowchart-canvas {
            flex-direction: column;
            align-items: stretch;
            padding: 16px;
        }
        .arch-step-wrap {
            flex-direction: column;
            width: 100%;
            align-items: stretch;
        }
        .arch-step-wrap:last-child {
            flex: 1;
        }
        .arch-node-box {
            width: 100%;
        }
        .arch-connector {
            padding: 8px 0;
            flex-direction: column;
        }
        .connector-line-h, .connector-arrow-h {
            display: none;
        }
        .connector-v {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .connector-line-v {
            width: 2px;
            height: 18px;
            background: linear-gradient(180deg, rgba(227, 168, 87, 0.3), rgba(227, 168, 87, 0.9));
        }
        .connector-arrow-v {
            font-size: 10px;
            margin-top: -2px;
            color: var(--amber, #e3a857);
        }
    }
    .arch-flow-footer {
        display: flex;
        gap: 8px;
        align-items: baseline;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
    }
    .flow-label {
        color: var(--amber, #e3a857);
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.05em;
        white-space: nowrap;
    }
    .arch-flow-summary {
        color: rgba(244, 246, 252, 0.8);
        margin: 0;
    }
    .arch-deep-dive {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        margin-bottom: 20px;
        overflow: hidden;
    }
    .deep-dive-trigger {
        padding: 12px 16px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: var(--steel, #f4f6fc);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
    }
    .deep-dive-trigger:hover {
        background: rgba(255, 255, 255, 0.04);
        color: var(--amber);
    }
    .deep-dive-body {
        padding: 14px 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 16px;
        line-height: 1.6;
        color: var(--steel, #f4f6fc);
    }
    .deep-dive-body p {
        margin: 0 0 10px 0;
    }
    .deep-dive-body p:last-child {
        margin-bottom: 0;
    }
    .project-deliverables {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 6px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }
    .deliv-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: var(--amber);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 8px;
    }
    .project-deliverables ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px 16px;
    }
    .project-deliverables li {
        display: flex;
        align-items: baseline;
        gap: 8px;
        color: var(--steel, #f4f6fc);
        font-size: 13.5px;
    }
    .bullet {
        color: var(--amber);
        font-weight: bold;
    }
    .project-links {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 20px;
        flex-wrap: wrap;
    }
    .btn-live {
        background: var(--amber);
        color: var(--ink);
        padding: 8px 16px;
        border-radius: 3px;
        font-size: 17px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s ease;
    }
    .btn-live:hover {
        background: #eab86c;
    }
    .btn-repo {
        color: #cbd5e1;
        font-size: 17px;
        text-decoration: none;
        transition: color 0.15s ease;
    }
    .btn-repo:hover {
        color: #fff;
    }
    .project-cta-banner {
        background: linear-gradient(135deg, rgba(26, 12, 44, 0.8) 0%, rgba(14, 10, 24, 0.8) 100%);
        border: 1px solid rgba(227, 168, 87, 0.3);
        border-radius: 8px;
        padding: 32px 36px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 32px;
        flex-wrap: wrap;
    }
    .banner-content h3 {
        font-size: 22px;
        color: var(--paper, #fff);
        margin-bottom: 8px;
    }
    .banner-content p {
        color: var(--steel, #f4f6fc);
        font-size: 15.5px;
        margin: 0;
        max-width: 60ch;
        line-height: 1.55;
    }
    .banner-btn {
        white-space: nowrap;
    }

    @media (max-width: 800px) {
        .project-card {
            grid-template-columns: 1fr;
            gap: 16px;
        }
        .project-deliverables ul {
            grid-template-columns: 1fr;
        }
        .project-cta-banner {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

---
import { site } from '../data/site';
---

<footer class="site-footer reveal" id="footer">
    <div class="wrap">
        <div class="contact-grid">
            <div>
                <h2>Let's build together.</h2>
                <p>
                    I take on freelance and contract work alongside my job. Email is the best way to reach me; WhatsApp works too.
                </p>
            </div>
            <div class="contact-links">
                <a href={`mailto:${site.email}`}>{site.email}</a>
                <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
                <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="link-whatsapp">WhatsApp</a>
                <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">{site.githubLabel}</a>
                <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer">{site.linkedinLabel}</a>
                <a href={site.resumePath} download data-event="cv-download">Download CV (PDF)</a>
            </div>
        </div>
        <p class="foot-note">Built by {site.name}.</p>
    </div>
</footer>

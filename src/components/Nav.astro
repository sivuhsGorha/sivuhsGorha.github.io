---
import { site } from '../data/site';
import DarkVeil from './reactbits/DarkVeil.jsx';

interface Props {
    current?: 'home' | 'writing';
}

const { current = 'home' } = Astro.props;
const homePrefix = current === 'home' ? '' : '/';
---

<nav>
    <div class="bg-canvas-wrapper" style="position: absolute; inset: 0; z-index: 0; pointer-events: none;">
        <DarkVeil
            client:only="react"
            baseColor={[0.04, 0.015, 0.07]}
            veilColor={[0.16, 0.05, 0.28]}
            noiseIntensity={0.02}
            scanlineIntensity={0.03}
            speed={0.3}
            scanlineFrequency={0.05}
            warpAmount={0.2}
            resolutionScale={1}
            lightBaseColor={[0.95, 0.95, 0.98]}
            lightVeilColor={[0.85, 0.87, 0.92]}
        />
    </div>
    <div class="wrap" style="position: relative; z-index: 1;">
        <a class="nav-mark" href="/">
            <img src="/logo.png" alt="SBK Logo" class="nav-logo" width="38" height="38" />
            <span>{site.mark}</span>
        </a>
        <div class="nav-header-actions">
            <button type="button" class="nav-theme-btn" id="nav-theme-btn" title="Toggle Bright/Dim Mode" aria-label="Toggle Bright/Dim Mode">
                <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>
            <button
                class="nav-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="nav-links"
            >
                Menu
            </button>
        </div>
        <ul class="nav-links" id="nav-links">
            <li><a href={`${homePrefix}#about`}>About</a></li>
            <li><a href={`${homePrefix}#services`}>Services</a></li>
            <li><a href={`${homePrefix}#skills`}>Skills</a></li>
            <li><a href={`${homePrefix}#projects`}>Projects</a></li>
            <li>
                <a href="/writing" aria-current={current === 'writing' ? 'page' : undefined}
                    >Writing</a
                >
            </li>
            <li><a href={`${homePrefix}#contact`}>Contact</a></li>
            <li class="nav-theme-item">
                <button type="button" class="nav-theme-btn" id="nav-theme-btn-desktop" title="Toggle Bright/Dim Mode" aria-label="Toggle Bright/Dim Mode">
                    <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                </button>
            </li>
            <li class="nav-terminal-item">
                <button type="button" class="nav-terminal-btn" id="nav-terminal-btn" title="Open Interactive Terminal (Press ~)">
                    <span class="terminal-prompt">&gt;_</span>
                    <span>Terminal</span>
                </button>
            </li>
            <li class="nav-cta-item">
                <a href={`${homePrefix}#contact`} class="nav-cta-btn">
                    <span>Hire Me</span>
                </a>
            </li>
        </ul>
    </div>
</nav>

<style>
    /* ── Mobile header action row (theme toggle + menu button) ── */
    .nav-header-actions {
        display: none;          /* hidden on desktop — shown via media query */
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    /* Theme toggle button (lives in the header row on mobile) */
    .nav-theme-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px solid rgba(227, 168, 87, 0.3);
        width: 34px;
        height: 34px;
        border-radius: 6px;
        color: var(--steel);
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }
    .nav-theme-btn:hover {
        background: rgba(227, 168, 87, 0.15);
        border-color: var(--amber);
        color: var(--amber);
    }

    .nav-terminal-item {
        display: flex;
        align-items: center;
    }
    .nav-terminal-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(15, 23, 42, 0.65);
        border: 1px solid rgba(227, 168, 87, 0.3);
        padding: 5px 12px;
        border-radius: 6px;
        color: var(--steel);
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .nav-terminal-btn:hover {
        background: rgba(227, 168, 87, 0.15);
        border-color: var(--amber);
        color: var(--amber);
    }
    .terminal-prompt {
        color: var(--amber);
        font-weight: 700;
    }
    .nav-cta-item {
        display: flex;
        align-items: center;
    }
    .nav-cta-btn {
        display: inline-flex !important;
        align-items: center;
        gap: 8px;
        background: rgba(227, 168, 87, 0.12);
        border: 1px solid rgba(227, 168, 87, 0.4);
        padding: 5px 14px;
        border-radius: 6px;
        color: var(--amber) !important;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13.5px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .nav-cta-btn:hover {
        background: rgba(227, 168, 87, 0.25);
        border-color: var(--amber);
        transform: translateY(-1px);
        box-shadow: 0 0 14px rgba(227, 168, 87, 0.25);
    }

    /* ── Mobile breakpoint ── */
    @media (max-width: 760px) {
        /* Show the header action row (theme btn + Menu btn) */
        .nav-header-actions {
            display: flex;
        }
        /* Hide the desktop inline theme item from the dropdown */
        .nav-theme-item {
            display: none;
        }
    }

</style>

<script>
    const toggle = document.querySelector('.nav-toggle');
    const links = document.getElementById('nav-links');
    if (toggle instanceof HTMLButtonElement && links) {
        toggle.addEventListener('click', () => {
            const open = links.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', String(open));
        });
        links.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
                links.classList.remove('is-open');
                toggle.setAttribute('aria-expanded', 'false');
            });
        });
    }

    const termBtn = document.getElementById('nav-terminal-btn');
    if (termBtn) {
        termBtn.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('open-terminal'));
        });
    }

    // Shared theme toggle logic — syncs both mobile (#nav-theme-btn) and desktop (#nav-theme-btn-desktop)
    function applyThemeToButton(btn: HTMLElement | null) {
        if (!btn) return;
        const isBright = document.documentElement.getAttribute('data-theme') === 'bright';
        const sun = btn.querySelector('.sun-icon') as HTMLElement | null;
        const moon = btn.querySelector('.moon-icon') as HTMLElement | null;
        if (sun) sun.style.display = isBright ? 'none' : 'block';
        if (moon) moon.style.display = isBright ? 'block' : 'none';
    }

    function toggleTheme() {
        const isBright = document.documentElement.getAttribute('data-theme') === 'bright';
        if (isBright) {
            document.documentElement.setAttribute('data-theme', 'dim');
            localStorage.setItem('theme:preference', 'dim');
        } else {
            document.documentElement.setAttribute('data-theme', 'bright');
            localStorage.setItem('theme:preference', 'bright');
        }
        applyThemeToButton(document.getElementById('nav-theme-btn'));
        applyThemeToButton(document.getElementById('nav-theme-btn-desktop'));
    }

    const mobileBtn = document.getElementById('nav-theme-btn');
    const desktopBtn = document.getElementById('nav-theme-btn-desktop');

    applyThemeToButton(mobileBtn);
    applyThemeToButton(desktopBtn);

    mobileBtn?.addEventListener('click', toggleTheme);
    desktopBtn?.addEventListener('click', toggleTheme);
</script>

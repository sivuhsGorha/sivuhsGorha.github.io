---
import { site } from '../data/site';
import Scanner from './reactbits/Scanner.jsx';

interface Props {
    current?: 'home' | 'writing';
}

const { current = 'home' } = Astro.props;
const homePrefix = current === 'home' ? '' : '/';
---

<nav style="position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; z-index: 0; pointer-events: none;">
        <Scanner
            client:only="react"
            color1="#0f1b2d"
            color2="#8a2be2"
            color3="#00e5ff"
            speed={0.4}
            sweepSpeed={0.18}
            sweepWidth={2.0}
            sweepFalloff={8}
            scale={1.2}
            frequency={1.5}
            ripple={0.15}
            bandDensity={14}
            lineSharpness={6}
            glow={0.18}
            scanDirection="horizontal"
            colorSpread={0.6}
            brightness={0.9}
            contrast={1.2}
            softness={1.6}
            vignette={0.5}
            scanline={false}
            grain={true}
            grainIntensity={0.03}
            opacity={0.85}
            mouseInteraction={true}
            mouseRadius={0.6}
            mouseStrength={0.4}
        />
    </div>
    <div class="wrap" style="position: relative; z-index: 1;">
        <a class="nav-mark" href="/">
            <img src="/logo.svg" alt="SBK Logo" class="nav-logo" width="38" height="38" />
            <span>{site.mark}</span>
        </a>
        <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="nav-links"
        >
            Menu
        </button>
        <ul class="nav-links" id="nav-links">
            <li><a href={`${homePrefix}#about`}>About</a></li>
            <li><a href={`${homePrefix}#skills`}>Skills</a></li>
            <li><a href={`${homePrefix}#projects`}>Projects</a></li>
            <li>
                <a href="/writing" aria-current={current === 'writing' ? 'page' : undefined}
                    >Writing</a
                >
            </li>
            <li><a href={`${homePrefix}#contact`}>Contact</a></li>
        </ul>
    </div>
</nav>

<script>
    const toggle = document.querySelector('.nav-toggle');
    const links = document.getElementById('nav-links');
    if (toggle instanceof HTMLButtonElement && links) {
        toggle.addEventListener('click', () => {
            const open = links.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', String(open));
        });
        links.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
                links.classList.remove('is-open');
                toggle.setAttribute('aria-expanded', 'false');
            });
        });
    }
</script>

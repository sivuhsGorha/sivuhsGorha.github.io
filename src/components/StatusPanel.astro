---
import { site } from '../data/site';
---

<div class="panel freelance-status-panel">
    <div class="panel-head">
        <div class="head-left">
            <span>telemetry.status</span>
        </div>
        <span class="panel-pill">AVAILABLE</span>
    </div>
    <div class="panel-body">
        <div class="panel-row">
            <span>availability</span>
            <span class="ok">● Open for Projects</span>
        </div>
        <div class="panel-row">
            <span>specialty</span>
            <span class="highlight-val">Full-Stack & AWS Cloud</span>
        </div>
        <div class="panel-row">
            <span>active_cloud</span>
            <span class="aws-val">AWS (VPC, EC2, CI/CD)</span>
        </div>
        <div class="panel-row">
            <span>response_time</span>
            <span>{site.responseTime}</span>
        </div>
        <div class="panel-row">
            <span>location</span>
            <span>{site.locationPill}</span>
        </div>
        <div class="panel-row">
            <span>session_uptime</span>
            <span id="uptime">00:00:00</span>
        </div>
    </div>
    <div class="panel-foot">
        <a href="#contact" class="panel-action-btn">
            <span>Start a project inquiry</span>
            <span class="action-arrow">→</span>
        </a>
        <button type="button" class="panel-term-btn" id="status-term-btn">
            <span>Interactive terminal</span>
            <span class="term-kbd">[ &gt;_ ]</span>
        </button>
    </div>
</div>

<style>
    .freelance-status-panel {
        border-color: rgba(227, 168, 87, 0.3);
        background: rgba(14, 10, 24, 0.75);
    }
    .head-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .panel-pill {
        margin-left: auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #10b981;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        padding: 2px 8px;
        border-radius: 999px;
    }
    .highlight-val {
        color: var(--paper, #fff);
        font-weight: 600;
    }
    .aws-val {
        color: #ff9900 !important;
        font-weight: 500;
    }
    .panel-foot {
        border-top: 1px solid rgba(227, 168, 87, 0.14);
        padding: 10px 18px;
        background: rgba(227, 168, 87, 0.04);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .panel-action-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--amber);
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .panel-action-btn:hover {
        color: #fff;
        transform: translateX(2px);
    }
    .panel-term-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: transparent;
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding-top: 6px;
        color: var(--steel);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        cursor: pointer;
        transition: color 0.2s ease;
    }
    .panel-term-btn:hover {
        color: var(--amber);
    }
    .term-kbd {
        color: var(--amber);
        font-weight: 600;
    }
    .action-arrow {
        transition: transform 0.2s ease;
    }
    .panel-action-btn:hover .action-arrow {
        transform: translateX(4px);
    }
</style>

<script>
    const start = Date.now();
    const el = document.getElementById('uptime');
    function pad(n: number) {
        return n.toString().padStart(2, '0');
    }
    function tick() {
        if (!el) return;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) {
            el.textContent = '00:00:00';
            return;
        }
        const diff = Math.floor((Date.now() - start) / 1000);
        const h = Math.floor(diff / 3600);
        const m = Math.floor((diff % 3600) / 60);
        const s = diff % 60;
        el.textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
    }
    tick();
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setInterval(tick, 1000);
    }

    const statusTermBtn = document.getElementById('status-term-btn');
    if (statusTermBtn) {
        statusTermBtn.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('open-terminal'));
        });
    }
</script>

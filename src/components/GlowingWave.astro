---
interface Props {
	class?: string;
}

const { class: className = '' }: Props = Astro.props;
---

<canvas
	id="glowing-wave"
	class={`glowing-wave ${className}`}
	aria-hidden="true"
/>

<script>
	(() => {
		const canvas = document.getElementById('glowing-wave');
		if (!canvas) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduced) {
			canvas.style.display = 'none';
			return;
		}

		let width = 0;
		let height = 0;
		let raf = 0;

		const resize = () => {
			const parent = canvas.parentElement;
			if (!parent) return;
			const rect = parent.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = rect.width;
			height = rect.height;
			canvas.width = width * dpr;
			canvas.height = height * dpr;
			canvas.style.width = `${width}px`;
			canvas.style.height = `${height}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		};

		const draw = (t: number) => {
			ctx.clearRect(0, 0, width, height);

			const yCenter = height * 0.55;
			const amplitude = height * 0.18;
			const frequency = 0.0018;

			ctx.beginPath();
			for (let x = 0; x <= width; x += 2) {
				const y =
					yCenter +
					Math.sin(x * frequency + t * 0.0005) * amplitude +
					Math.sin(x * frequency * 2.4 + t * 0.0009) * amplitude * 0.35;
				if (x === 0) ctx.moveTo(x, y);
				else ctx.lineTo(x, y);
			}
			ctx.lineTo(width, height);
			ctx.lineTo(0, height);
			ctx.closePath();

			const gradient = ctx.createLinearGradient(0, yCenter - amplitude, 0, height);
			gradient.addColorStop(0, 'rgba(127, 168, 140, 0.25)');
			gradient.addColorStop(1, 'rgba(226, 176, 95, 0)');
			ctx.fillStyle = gradient;
			ctx.fill();

			raf = requestAnimationFrame(draw);
		};

		const start = () => {
			resize();
			if (raf) cancelAnimationFrame(raf);
			raf = requestAnimationFrame(draw);
		};

		start();
		window.addEventListener('resize', resize);
	})();
</script>

<style>
	.glowing-wave {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
		mask-image: radial-gradient(ellipse at center, black 35%, transparent 70%);
		-webkit-mask-image: radial-gradient(ellipse at center, black 35%, transparent 70%);
	}
	.glowing-wave + * {
		position: relative;
		z-index: 1;
	}
</style>

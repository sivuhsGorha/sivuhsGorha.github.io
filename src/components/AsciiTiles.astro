---
interface Props {
	class?: string;
	glyphSize?: number;
	tileDensity?: number;
	speed?: number;
	cursorInteraction?: boolean;
	glyphColor?: string;
	recessColor?: string;
}

const {
	class: className = '',
	glyphSize = 8,
	tileDensity = 3.3,
	speed = 1,
	cursorInteraction = true,
	glyphColor = '#E3A857',
	recessColor = '#0F1B2D',
}: Props = Astro.props;
---

<canvas
	id="ascii-tiles"
	class={`ascii-tiles ${className}`}
	aria-hidden="true"
	data-glyph-size={glyphSize}
	data-speed={speed}
	data-cursor-interaction={cursorInteraction}
	data-glyph-color={glyphColor}
/>

<script>
	(() => {
		const canvas = document.getElementById('ascii-tiles') as HTMLCanvasElement;
		if (!canvas) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		// Read configuration from data attributes
		const glyphSize = Number(canvas.dataset.glyphSize) || 8;
		const speed = Number(canvas.dataset.speed) || 1;
		const cursorInteraction = canvas.dataset.cursorInteraction === 'true';
		const glyphColor = canvas.dataset.glyphColor || '#E3A857';

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduced) {
			canvas.style.display = 'none';
			return;
		}

		let width = 0;
		let height = 0;
		let raf = 0;
		let mouseX = -1000;
		let mouseY = -1000;

		// Extended ASCII character set for tech feel
		const chars = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ@#$%&*+-=/<>?';
		const tileSize = glyphSize;
		const cols = () => Math.max(1, Math.floor(width / tileSize));
		const rows = () => Math.max(1, Math.floor(height / tileSize));
		
		// Grid stores tile data: char, alpha, phase
		const grid: Array<{char: string, alpha: number, phase: number}>[] = [];

		const initGrid = () => {
			const c = cols();
			const r = rows();
			grid.length = 0;
			for (let y = 0; y < r; y++) {
				grid[y] = [];
				for (let x = 0; x < c; x++) {
					grid[y][x] = {
						char: chars[Math.floor(Math.random() * chars.length)],
						alpha: Math.random() * 0.3 + 0.1,
						phase: Math.random() * Math.PI * 2
					};
				}
			}
		};

		const resize = () => {
			const parent = canvas.parentElement;
			if (!parent) return;
			const rect = parent.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = rect.width;
			height = rect.height;
			canvas.width = width * dpr;
			canvas.height = height * dpr;
			canvas.style.width = `${width}px`;
			canvas.style.height = `${height}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			initGrid();
		};

		const draw = (time: number) => {
			ctx.clearRect(0, 0, width, height);
			ctx.font = `${glyphSize - 1}px "JetBrains Mono", monospace`;
			ctx.textBaseline = 'top';

			const c = cols();
			const r = rows();
			const timeScale = time * 0.001 * speed;

			for (let y = 0; y < r; y++) {
				for (let x = 0; x < c; x++) {
					const tile = grid[y][x];
					
					// Subtle character flickering
					if (Math.random() > 0.995) {
						tile.char = chars[Math.floor(Math.random() * chars.length)];
					}

					// Animated glow effect
					const glowAlpha = tile.alpha + Math.sin(timeScale + tile.phase) * 0.05;
					const clampedAlpha = Math.max(0.05, Math.min(0.5, glowAlpha));

					// Cursor interaction
					let interactionBoost = 0;
					if (cursorInteraction) {
						const tileX = x * tileSize;
						const tileY = y * tileSize;
						const dist = Math.sqrt(
							Math.pow(tileX - mouseX, 2) + 
							Math.pow(tileY - mouseY, 2)
						);
						const radius = 150;
						if (dist < radius) {
							interactionBoost = (1 - dist / radius) * 0.4;
						}
					}

					// Draw glassy tile background
					const finalAlpha = Math.min(0.8, clampedAlpha + interactionBoost);
					
					// Create glassy effect with subtle gradient
					const gradient = ctx.createLinearGradient(
						x * tileSize, y * tileSize,
						x * tileSize + tileSize, y * tileSize + tileSize
					);
					gradient.addColorStop(0, `rgba(226, 176, 95, ${finalAlpha * 0.1})`);
					gradient.addColorStop(1, `rgba(92, 112, 134, ${finalAlpha * 0.05})`);
					
					ctx.fillStyle = gradient;
					ctx.fillRect(x * tileSize, y * tileSize, tileSize - 1, tileSize - 1);

					// Draw character with glow
					ctx.fillStyle = glyphColor;
					ctx.globalAlpha = finalAlpha;
					ctx.fillText(tile.char, x * tileSize + 1, y * tileSize + 1);
					ctx.globalAlpha = 1;

					// Add subtle bevel effect
					ctx.strokeStyle = `rgba(226, 176, 95, ${finalAlpha * 0.2})`;
					ctx.lineWidth = 0.5;
					ctx.strokeRect(x * tileSize, y * tileSize, tileSize - 1, tileSize - 1);
				}
			}

			raf = requestAnimationFrame(draw);
		};

		const start = () => {
			resize();
			if (raf) cancelAnimationFrame(raf);
			raf = requestAnimationFrame(draw);
		};

		// Cursor tracking
		if (cursorInteraction) {
			const handleMouseMove = (e: MouseEvent) => {
				const rect = canvas.getBoundingClientRect();
				mouseX = e.clientX - rect.left;
				mouseY = e.clientY - rect.top;
			};
			const handleMouseLeave = () => {
				mouseX = -1000;
				mouseY = -1000;
			};
			canvas.addEventListener('mousemove', handleMouseMove);
			canvas.addEventListener('mouseleave', handleMouseLeave);
		}

		start();
		window.addEventListener('resize', resize);
	})();
</script>

<style>
	.ascii-tiles {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
		opacity: 0.9;
		mask-image: radial-gradient(ellipse at center, black 40%, transparent 75%);
		-webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 75%);
	}
	.ascii-tiles + * {
		position: relative;
		z-index: 1;
	}
</style>

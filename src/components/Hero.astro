---
import { site } from '../data/site';
import GradientBlinds from './reactbits/GradientBlinds.jsx';
---

<header class="hero reveal" style="position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; z-index: 0; pointer-events: none; mask-image: linear-gradient(to bottom, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);">
        <GradientBlinds
            client:only="react"
            gradientColors={['#d8b4fe', '#a855f7', '#7c3aed', '#3b0764']}
            lightGradientColors={['#ffffff', '#f1f5f9', '#cbd5e1', '#94a3b8', '#e2e8f0', '#64748b']}
            angle={45}
            noise={0.3}
            blindCount={18}
            blindMinWidth={60}
            spotlightRadius={0.65}
            spotlightSoftness={1}
            spotlightOpacity={1.2}
            mouseDampening={0.15}
            distortAmount={0}
            shineDirection="left"
            mixBlendMode="lighten"
            mixBlendModeLight="normal"
            mirrorGradient={true}
        />
    </div>
    <div class="wrap hero-wrap" style="position: relative; z-index: 1;">
        <div class="hero-content">
            <p class="role">{site.role}</p>
            <h1>{site.tagline}</h1>
            <p class="desc">{site.description}</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="#contact">Start a Project</a>
                <a class="btn btn-whatsapp" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                    </svg>
                </a>
                <a class="btn btn-outline" href="#services">View Services</a>
                <a class="btn btn-ghost" href="#projects">See the work</a>
                <a class="cv-link" href={site.resumePath} download data-event="cv-download">Download CV (PDF) ↓</a>
            </div>
        </div>
    </div>
</header>

<style>
    .hero-content {
        max-width: 860px;
    }
    .hero-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 12px;
    }
    .btn-whatsapp {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        padding: 0;
        border-radius: 3px;
        text-decoration: none;
        background: rgba(227, 168, 87, 0.08);
        border: 1px solid rgba(227, 168, 87, 0.4);
        color: var(--amber);
        transition: all 0.2s ease;
    }
    .btn-whatsapp:hover,
    .btn-whatsapp:focus-visible {
        background: rgba(37, 211, 102, 0.16);
        border-color: #25d366;
        color: #25d366;
        box-shadow: 0 0 16px rgba(37, 211, 102, 0.4);
        transform: translateY(-1px);
    }
    .btn-outline {
        display: inline-block;
        padding: 13px 22px;
        border-radius: 3px;
        font-size: 16px;
        text-decoration: none;
        border: 1px solid rgba(227, 168, 87, 0.4);
        color: var(--amber);
        transition: all 0.2s ease;
    }
    .btn-outline:hover {
        background: rgba(227, 168, 87, 0.12);
        border-color: var(--amber);
        color: #fff;
    }
    .cv-link {
        font-family: 'JetBrains Mono', monospace;
        font-size: 16px;
        color: var(--steel);
        text-decoration: underline;
        text-underline-offset: 4px;
        margin-left: 6px;
        transition: color 0.15s ease;
    }
    .cv-link:hover {
        color: var(--amber);
    }
</style>

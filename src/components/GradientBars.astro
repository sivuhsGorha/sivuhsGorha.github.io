---
interface Props {
	class?: string;
}

const { class: className = '' }: Props = Astro.props;
---

<canvas
	id="gradient-bars"
	class={`gradient-bars ${className}`}
	aria-hidden="true"
/>

<script>
	(() => {
		const canvas = document.getElementById('gradient-bars');
		if (!canvas) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduced) {
			canvas.style.display = 'none';
			return;
		}

		let width = 0;
		let height = 0;
		let raf = 0;

		const count = 7;
		const bars = Array.from({ length: count }, () => ({
			x: Math.random(),
			width: 0.08 + Math.random() * 0.14,
			speed: 0.0002 + Math.random() * 0.0003,
			phase: Math.random() * Math.PI * 2,
		}));

		const resize = () => {
			const parent = canvas.parentElement;
			if (!parent) return;
			const rect = parent.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = rect.width;
			height = rect.height;
			canvas.width = width * dpr;
			canvas.height = height * dpr;
			canvas.style.width = `${width}px`;
			canvas.style.height = `${height}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		};

		const draw = (t: number) => {
			ctx.clearRect(0, 0, width, height);

			bars.forEach((bar) => {
				const xBase = bar.x * width;
				const barWidth = bar.width * width;
				const yOffset = Math.sin(t * bar.speed + bar.phase) * height * 0.25;

				const gradient = ctx.createLinearGradient(0, 0, 0, height);
				gradient.addColorStop(0, 'rgba(226, 176, 95, 0)');
				gradient.addColorStop(0.5, 'rgba(226, 176, 95, 0.18)');
				gradient.addColorStop(1, 'rgba(226, 176, 95, 0)');

				ctx.fillStyle = gradient;
				ctx.fillRect(xBase, yOffset, barWidth, height);
			});

			raf = requestAnimationFrame(draw);
		};

		const start = () => {
			resize();
			if (raf) cancelAnimationFrame(raf);
			raf = requestAnimationFrame(draw);
		};

		start();
		window.addEventListener('resize', resize);
	})();
</script>

<style>
	.gradient-bars {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
		mask-image: radial-gradient(ellipse at center, black 25%, transparent 70%);
		-webkit-mask-image: radial-gradient(ellipse at center, black 25%, transparent 70%);
	}
	.gradient-bars + * {
		position: relative;
		z-index: 1;
	}
</style>

---
// Services.astro: what I take on as freelance or contract work
const services = [
    {
        num: '01',
        category: 'Backend',
        title: 'APIs and database design',
        description:
            'REST APIs and normalised MySQL or SQL Server schemas. I have built one for a lender: encrypted customer data, role-based access, audit logs and multi-factor login.',
        deliverables: [
            'REST API design and integration',
            'Relational schema design (MySQL, SQL Server)',
            'Authentication, authorisation and input validation',
            'Business logic and data export workflows'
        ],
        tech: ['Java', 'PHP', 'Node.js', 'MySQL', 'Microsoft SQL Server']
    },
    {
        num: '02',
        category: 'Web',
        title: 'Web applications and client portals',
        description:
            'Customer portals, admin dashboards and business websites, built in React or Astro on a PHP or Node backend. Responsive, quick to load, and designed around what the business needs to do.',
        deliverables: [
            'React and Astro front ends',
            'Customer portals and admin interfaces',
            'Layouts that work on phone and desktop',
            'Performance and SEO basics done properly'
        ],
        tech: ['React', 'Astro', 'PHP', 'JavaScript / TypeScript', 'HTML5/CSS3']
    },
    {
        num: '03',
        category: 'Cloud (learning)',
        title: 'AWS setup: VPCs, EC2 and CI/CD',
        description:
            'I work with AWS at Future ProTechY and am still learning it. I can set up a VPC, EC2 instances and a GitHub Actions deployment, and I am clear about where I would want a more experienced engineer to review the result.',
        deliverables: [
            'VPC, subnets and security groups',
            'EC2 provisioning and Linux administration',
            'GitHub Actions and Docker deployments',
            'Working alongside your team or a senior reviewer'
        ],
        tech: ['AWS (VPC, EC2, ALB)', 'GitHub Actions', 'Docker', 'Nginx', 'Linux']
    },
    {
        num: '04',
        category: 'Security and maintenance',
        title: 'Security review and ongoing support',
        description:
            'A review of an existing application for common security problems, fixes for production bugs, performance work, and ongoing support if you want someone to call.',
        deliverables: [
            'Review against common vulnerability classes',
            'Bug fixes and performance work on existing code',
            'Server hardening, reverse proxy and firewall setup',
            'Ongoing support by arrangement'
        ],
        tech: ['PHP', 'Java', 'Linux', 'Nginx', 'Git']
    }
];
---

<section id="services" class="reveal services-section">
    <div class="wrap">
        <p class="eyebrow-num">03 / services</p>
        <div class="services-header">
            <div>
                <h2>Services & Solutions</h2>
                <p class="services-sub">
                    Web applications, backends and databases, and help with AWS. Here is what I take on.
                </p>
            </div>
        </div>

        <!-- Services Cards Grid -->
        <div class="services-grid">
            {services.map((svc) => (
                <div class="service-card">
                    <div class="card-top">
                        <span class="card-num">{svc.num}</span>
                        <span class="card-badge">{svc.category}</span>
                    </div>

                    <h3 class="card-title">{svc.title}</h3>
                    <p class="card-desc">{svc.description}</p>

                    <div class="card-deliverables">
                        <p class="deliv-heading">Key Deliverables:</p>
                        <ul>
                            {svc.deliverables.map((item) => (
                                <li>
                                    <span class="bullet">→</span>
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="card-footer">
                        <div class="card-tech">
                            {svc.tech.map((t) => (
                                <span class="tech-chip">{t}</span>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>

<style>
    .services-section {
        position: relative;
    }
    .services-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 32px;
        margin-bottom: 48px;
        flex-wrap: wrap;
    }
    .services-sub {
        color: var(--steel, #f4f6fc);
        font-size: 19px;
        max-width: 62ch;
        margin-top: -16px;
        line-height: 1.6;
    }
    .services-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 28px;
        margin-bottom: 56px;
    }
    .service-card {
        background: rgba(14, 10, 24, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(227, 168, 87, 0.16);
        border-radius: 8px;
        padding: 32px;
        display: flex;
        flex-direction: column;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        position: relative;
    }
    .service-card:hover {
        transform: translateY(-3px);
        border-color: rgba(227, 168, 87, 0.5);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 0 24px rgba(227, 168, 87, 0.12);
    }
    .card-top {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }
    .card-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 17px;
        color: var(--amber);
        font-weight: 600;
    }
    .card-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: var(--amber);
        background: rgba(227, 168, 87, 0.08);
        padding: 3px 10px;
        border-radius: 4px;
        border: 1px solid rgba(227, 168, 87, 0.22);
    }
    .card-title {
        font-size: 24px;
        line-height: 1.25;
        margin-bottom: 14px;
        color: var(--paper, #fff);
    }
    .card-desc {
        color: var(--steel, #f4f6fc);
        font-size: 17px;
        line-height: 1.6;
        margin-bottom: 24px;
    }
    .card-deliverables {
        margin-bottom: 24px;
        flex-grow: 1;
    }
    .deliv-heading {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--amber);
        margin-bottom: 10px;
    }
    .card-deliverables ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .card-deliverables li {
        display: flex;
        gap: 8px;
        color: var(--steel, #f4f6fc);
        font-size: 14.5px;
        line-height: 1.45;
    }
    .bullet {
        color: var(--amber);
        font-family: 'JetBrains Mono', monospace;
    }
    .card-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 18px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .card-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
    .tech-chip {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        background: rgba(227, 168, 87, 0.08);
        color: var(--steel, #f4f6fc);
        border: 1px solid rgba(227, 168, 87, 0.22);
        padding: 3px 8px;
        border-radius: 3px;
    }

    @media (max-width: 900px) {
        .services-grid {
            grid-template-columns: 1fr;
        }
    }
    @media (max-width: 600px) {
        .service-card {
            padding: 24px;
        }
    }
</style>

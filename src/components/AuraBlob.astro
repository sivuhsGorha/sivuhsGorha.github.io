---
interface Props {
	class?: string;
}

const { class: className = '' }: Props = Astro.props;
---

<canvas
	id="aura-blob"
	class={`aura-blob ${className}`}
	aria-hidden="true"
/>

<script>
	(() => {
		const canvas = document.getElementById('aura-blob');
		if (!canvas) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduced) {
			canvas.style.display = 'none';
			return;
		}

		let width = 0;
		let height = 0;
		let raf = 0;

		const blobs = [
			{ color: 'rgba(226, 176, 95, 0.08)', radius: 0.35, x: 0.35, y: 0.4, speed: 0.0004, phase: 0 },
			{ color: 'rgba(127, 168, 140, 0.06)', radius: 0.3, x: 0.65, y: 0.55, speed: 0.00035, phase: 2 },
			{ color: 'rgba(92, 112, 134, 0.05)', radius: 0.32, x: 0.5, y: 0.35, speed: 0.00045, phase: 4 },
		];

		const resize = () => {
			const parent = canvas.parentElement;
			if (!parent) return;
			const rect = parent.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = rect.width;
			height = rect.height;
			canvas.width = width * dpr;
			canvas.height = height * dpr;
			canvas.style.width = `${width}px`;
			canvas.style.height = `${height}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		};

		const draw = (t: number) => {
			ctx.clearRect(0, 0, width, height);

			blobs.forEach((blob) => {
				const cx = blob.x * width + Math.sin(t * blob.speed + blob.phase) * width * 0.12;
				const cy = blob.y * height + Math.cos(t * blob.speed * 1.3 + blob.phase) * height * 0.1;
				const radius = blob.radius * Math.min(width, height);

				const gradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
				gradient.addColorStop(0, blob.color);
				gradient.addColorStop(1, 'rgba(15, 27, 45, 0)');

				ctx.beginPath();
				ctx.arc(cx, cy, radius, 0, Math.PI * 2);
				ctx.fillStyle = gradient;
				ctx.fill();
			});

			raf = requestAnimationFrame(draw);
		};

		const start = () => {
			resize();
			if (raf) cancelAnimationFrame(raf);
			raf = requestAnimationFrame(draw);
		};

		start();
		window.addEventListener('resize', resize);
	})();
</script>

<style>
	.aura-blob {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
		opacity: 0.95;
	}
	.aura-blob + * {
		position: relative;
		z-index: 1;
	}
</style>
